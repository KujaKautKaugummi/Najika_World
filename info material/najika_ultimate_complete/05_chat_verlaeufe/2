                        content = f.read()
                        file_info["inhalt"] = content
                        print(f"\n📄 {rel_path}/{file}:")
                        print("-" * 30)
                        print(content[:500] + "..." if len(content) > 500 else content)
                        
                except Exception as e:
                    try:
