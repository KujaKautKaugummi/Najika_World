# -*- coding: utf-8 -*-
import numpy as np
import json, random, os
try:
    from noise import pnoise2
except:
    def pnoise2(x,y,octaves=1,persistence=0.5,lacunarity=2.0,repeatx=1024,repeaty=1024,base=0):
        return (x*0.1+y*0.1)%%1.0-0.5

class NajikaWorld:
    def __init__(self):
        self.world_size = (100, 100)
        self.seed = random.randint(0, 999999)
        self.player_pos = [50, 50]

        # GEBAEUDE in der Welt
        self.buildings = {
            \"schwarze_muehle\": {
                \"position\": [50, 50],
                \"name\": \"Schwarze Muehle\",
                \"floors\": {
                    \"erdgeschoss\": [\"wohnzimmer\", \"kueche\", \"bad\"],
                    \"obergeschoss\": [\"schlafzimmer\", \"musikzimmer\", \"medizin\"],
                    \"turm\": [\"terminal\"],
                    \"keller\": [\"trainingsraum\", \"studierzimmer\", \"oregon_portal\"],
                    \"aussen\": [\"werkstatt\", \"garten\", \"teich\"]
                }
            },
            \"dungeon_1\": {\"position\": [20, 20], \"name\": \"Dungeon 1\", \"boss\": \"Schatten-Najika\"},
            \"dungeon_2\": {\"position\": [80, 20], \"name\": \"Dungeon 2\", \"boss\": \"Explosion-Geist\"},
            \"dungeon_3\": {\"position\": [50, 80], \"name\": \"Dungeon 3\", \"boss\": \"Korrumpierter Waechter\", \"locked\": True}
        }

        self.world_tiles = []
        self.generate_world()

    def generate_world(self):
        print(f\"[WORLD] Generiere Welt mit Seed: {self.seed}\")
        world_map = np.zeros(self.world_size)

        for y in range(self.world_size[1]):
            for x in range(self.world_size[0]):
                nx, ny = x/10.0, y/10.0
                elevation = pnoise2(nx+self.seed, ny+self.seed, octaves=6)
                world_map[y][x] = elevation

        # Elevation zu Biomen
        for row in world_map:
            biome_row = []
            for elev in row:
                if elev<-0.3: biome=\"lake\"
                elif elev<0: biome=\"meadow\"
                elif elev<0.3: biome=\"forest\"
                else: biome=\"mountain\"
                biome_row.append(biome)
            self.world_tiles.append(biome_row)

        # Platziere Gebaeude
        for building_id, data in self.buildings.items():
            x, y = data[\"position\"]
            self.world_tiles[y][x] = building_id

        print(f\"[OK] Welt generiert: {self.world_size[0]}x{self.world_size[1]} Tiles\")
        print(f\"[OK] Gebaeude: {len(self.buildings)}\")

    def move_player(self, direction):
        x, y = self.player_pos
        if direction==\"north\" and y>0: y-=1
        elif direction==\"south\" and y<99: y+=1
        elif direction==\"west\" and x>0: x-=1
        elif direction==\"east\" and x<99: x+=1
        self.player_pos = [x, y]
        return self.get_current_tile()

    def get_current_tile(self):
        x, y = self.player_pos
        biome = self.world_tiles[y][x]

        # Check ob auf Gebaeude
        building = None
        for building_id, data in self.buildings.items():
            if data[\"position\"] == [x, y]:
                building = {\"id\": building_id, \"name\": data[\"name\"]}
                if \"floors\" in data:
                    building[\"floors\"] = data[\"floors\"]
                break

        return {
            \"type\": biome,
            \"position\": self.player_pos,
            \"building\": building
        }

    def get_visible_area(self, radius=5):
        x, y = self.player_pos
        visible = []
        for dy in range(-radius, radius+1):
            row = []
            for dx in range(-radius, radius+1):
                wx, wy = x+dx, y+dy
                if 0<=wx<100 and 0<=wy<100:
                    tile = self.world_tiles[wy][wx]
                    row.append(tile)
                else:
                    row.append(\"void\")
            visible.append(row)
        return visible

    def enter_building(self, building_id):
        if building_id not in self.buildings:
            return {\"success\": False, \"message\": \"Gebaeude nicht gefunden\"}

        building = self.buildings[building_id]

        if building.get(\"locked\", False):
            return {\"success\": False, \"message\": \"Gesperrt!\"}

        return {
            \"success\": True,
            \"building\": building_id,
            \"name\": building[\"name\"],
            \"floors\": building.get(\"floors\", {}),
            \"boss\": building.get(\"boss\")
        }

    def save_world(self, fn=\"data/world_save/najika_world.json\"):
        data = {
            \"seed\": self.seed,
            \"player_pos\": self.player_pos,
            \"buildings\": self.buildings
        }
        os.makedirs(os.path.dirname(fn), exist_ok=True)
        with open(fn, \"w\") as f:
            json.dump(data, f, indent=2)
        print(f\"[OK] Welt gespeichert: {fn}\")

    def load_world(self, fn=\"data/world_save/najika_world.json\"):
        if not os.path.exists(fn):
            return False
        with open(fn) as f:
            data = json.load(f)
        self.seed = data.get(\"seed\", self.seed)
        self.player_pos = data.get(\"player_pos\", self.player_pos)
        self.generate_world()
        print(f\"[OK] Welt geladen: {fn}\")
        return True

if __name__ == \"__main__\":
    world = NajikaWorld()
    print(f\"Schwarze Muehle: {world.buildings[\"schwarze_muehle\"]}\")
