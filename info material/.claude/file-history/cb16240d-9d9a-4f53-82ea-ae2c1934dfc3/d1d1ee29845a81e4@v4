@echo off
title NAJIKA - Unified System
color 0A

echo ========================================
echo    NAJIKA UNIFIED SYSTEM STARTING
echo ========================================
echo.

REM Check if Ollama is installed
where ollama >nul 2>nul
if %errorlevel% equ 0 (
    echo [1/3] Starte Ollama...
    start /min cmd /c "ollama serve"
    timeout /t 3 /nobreak >nul
) else (
    echo [1/3] Ollama nicht gefunden - ueberspringe
)

REM Start Backend (serves Digivice UI!)
echo [2/2] Starte Najika Backend + Digivice...
start "Najika Backend" cmd /k "cd /d %~dp0backend && python najika_server.py"
timeout /t 5 /nobreak >nul

echo.
echo ========================================
echo    NAJIKA DIGIVICE IS RUNNING!
echo ========================================
echo.
echo Digivice UI: http://localhost:8000
echo Backend API: http://localhost:8000/api/
echo.
echo Features:
echo - Digivice 3D System (12 Rooms, KayKit Assets)
echo - Finisher QTE (Button-Mashing Damage Boost)
echo - Evolution System (Rookie -^> Mega)
echo - Battle System (Backend Connected)
echo - Voice System (Edge-TTS, 4 Personalities)
echo - LoRA Training (8B Adapter Ready)
echo - Memory System (ChromaDB)
echo.
echo Browser oeffnet sich in 3 Sekunden...
echo.

timeout /t 3 /nobreak >nul
start http://localhost:8000

echo Dr?cke eine Taste zum Beenden...
pause >nul
