@echo off
title NAJIKA - Unified System
color 0A

echo ========================================
echo    NAJIKA UNIFIED SYSTEM STARTING
echo ========================================
echo.

REM Check if Ollama is installed
where ollama >nul 2>nul
if %errorlevel% equ 0 (
    echo [1/3] Starte Ollama...
    start /min cmd /c "ollama serve"
    timeout /t 3 /nobreak >nul
) else (
    echo [1/3] Ollama nicht gefunden - ueberspringe
)

REM Start Backend
echo [2/3] Starte Najika Backend...
cd backend
start "Najika Backend" cmd /k python najika_server.py
cd ..
timeout /t 5 /nobreak >nul

REM Start Frontend
echo [3/3] Starte Najika Frontend...
cd frontend
start "Najika Frontend" cmd /k npm start
cd ..

echo.
echo ========================================
echo    NAJIKA IS RUNNING!
echo ========================================
echo.
echo Frontend: http://localhost:3002
echo Backend:  http://localhost:8000
echo.
echo Features:
echo - Game System (Digimon World Style)
echo - Battle API (Backend Connected)
echo - Voice System (Edge-TTS, 4 Personalities)
echo - LoRA Training (8B Adapter Ready)
echo - Memory System (ChromaDB)
echo.
echo Browser oeffnet sich automatisch...
echo.

timeout /t 3 /nobreak >nul
start http://localhost:3002

echo Dr?cke eine Taste zum Beenden...
pause >nul
