import React, { useState, useEffect } from 'react';
import { Canvas } from '@react-three/fiber';
import { OrbitControls, Sky, Environment } from '@react-three/drei';
import axios from 'axios';

// Najika Character Model (Placeholder)
function NajikaModel() {
  return (
    <mesh position={[0, 1, 0]}>
      <capsuleGeometry args={[0.5, 1.5, 4, 8]} />
      <meshStandardMaterial color="#FF6B9D" />
    </mesh>
  );
}

// Main App Component
function App() {
  const [backendStatus, setBackendStatus] = useState('checking...');

  useEffect(() => {
    // Check backend connection
    axios.get('http://127.0.0.1:5000/health')
      .then(response => {
        setBackendStatus('Connected ✅');
        console.log('Backend:', response.data);
      })
      .catch(error => {
        setBackendStatus('Disconnected ❌');
        console.error('Backend error:', error);
      });
  }, []);

  return (
    <div style={{ width: '100vw', height: '100vh', position: 'relative' }}>
      <div style={{
        position: 'absolute',
        top: '20px',
        left: '20px',
        zIndex: 100,
        background: 'rgba(0,0,0,0.7)',
        padding: '20px',
        borderRadius: '10px',
        color: 'white',
        fontFamily: 'monospace'
      }}>
        <h1 style={{ margin: 0, fontSize: '24px', color: '#FF6B9D' }}>
          🌟 NAJIKA V4
        </h1>
        <p style={{ margin: '10px 0 0 0', fontSize: '14px' }}>
          Backend: {backendStatus}
        </p>
        <p style={{ margin: '5px 0 0 0', fontSize: '12px', color: '#888' }}>
          Orbit Cam: WASD + Mouse
        </p>
      </div>

      <Canvas camera={{ position: [0, 2, 5], fov: 60 }} shadows>
        <Sky sunPosition={[100, 20, 100]} />
        <ambientLight intensity={0.3} />
        <directionalLight position={[10, 10, 5]} intensity={1} castShadow />
        
        <NajikaModel />
        
        <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, 0, 0]} receiveShadow>
          <planeGeometry args={[50, 50]} />
          <meshStandardMaterial color="#4CAF50" />
        </mesh>
        
        <OrbitControls target={[0, 1, 0]} maxPolarAngle={Math.PI / 2} minDistance={2} maxDistance={10} />
        <Environment preset="sunset" />
      </Canvas>
    </div>
  );
}

export default App;
