# NAJIKA LORA TRAINING SCHEDULER
# Installiert 2x tägliches Auto-Training

Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "NAJIKA LoRA AUTO-TRAINING SETUP" -ForegroundColor Cyan
Write-Host "============================================================`n" -ForegroundColor Cyan

# Lösche alte Tasks
Write-Host "Lösche alte Training-Tasks..." -ForegroundColor Yellow
schtasks /Delete /TN "NajikaLoRAMorning" /F 2>$null
schtasks /Delete /TN "NajikaLoRAEvening" /F 2>$null

Write-Host "`nErstelle neue Tasks...`n" -ForegroundColor Yellow

# Morning Training (08:00)
Write-Host "1. Morning Training (08:00 Uhr)..." -ForegroundColor Green
$action = New-ScheduledTaskAction -Execute "python" -Argument "C:\NajikaCore\najika_lora_training.py"
$trigger = New-ScheduledTaskTrigger -Daily -At 08:00
Register-ScheduledTask -TaskName "NajikaLoRAMorning" -Action $action -Trigger $trigger -Force | Out-Null

if ($?) {
    Write-Host "   [OK] Morning Training Task erstellt" -ForegroundColor Green
} else {
    Write-Host "   [FEHLER] Morning Training konnte nicht erstellt werden" -ForegroundColor Red
}

Write-Host ""

# Evening Training (20:00)
Write-Host "2. Evening Training (20:00 Uhr)..." -ForegroundColor Green
$action2 = New-ScheduledTaskAction -Execute "python" -Argument "C:\NajikaCore\najika_lora_training.py"
$trigger2 = New-ScheduledTaskTrigger -Daily -At 20:00
Register-ScheduledTask -TaskName "NajikaLoRAEvening" -Action $action2 -Trigger $trigger2 -Force | Out-Null

if ($?) {
    Write-Host "   [OK] Evening Training Task erstellt" -ForegroundColor Green
} else {
    Write-Host "   [FEHLER] Evening Training konnte nicht erstellt werden" -ForegroundColor Red
}

Write-Host "`n============================================================" -ForegroundColor Cyan
Write-Host "TRAINING-SCHEDULE" -ForegroundColor Cyan
Write-Host "============================================================`n" -ForegroundColor Cyan

Write-Host "08:00 Uhr - Morning Training" -ForegroundColor White
Write-Host "20:00 Uhr - Evening Training`n" -ForegroundColor White

Write-Host "= 2x täglich, alle 12 Stunden`n" -ForegroundColor Yellow

Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "SETUP ABGESCHLOSSEN!" -ForegroundColor Green
Write-Host "============================================================`n" -ForegroundColor Cyan
