# NAJIKA SESSION AUTO-IMPORTER
# Importiert täglich neue Claude-Sessions

Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "NAJIKA SESSION AUTO-IMPORT SETUP" -ForegroundColor Cyan
Write-Host "============================================================`n" -ForegroundColor Cyan

# Lösche alten Task
Write-Host "Lösche alten Import-Task..." -ForegroundColor Yellow
schtasks /Delete /TN "NajikaSessionImport" /F 2>$null

Write-Host "`nErstelle neuen Task...`n" -ForegroundColor Yellow

# Daily Import (23:30 Uhr - vor erstem Training)
Write-Host "Session-Import (23:30 Uhr täglich)..." -ForegroundColor Green
$action = New-ScheduledTaskAction -Execute "python" -Argument "C:\NajikaCore\najika_session_importer.py"
$trigger = New-ScheduledTaskTrigger -Daily -At 23:30
Register-ScheduledTask -TaskName "NajikaSessionImport" -Action $action -Trigger $trigger -Force | Out-Null

if ($?) {
    Write-Host "   [OK] Session-Import Task erstellt" -ForegroundColor Green
} else {
    Write-Host "   [FEHLER] Task konnte nicht erstellt werden" -ForegroundColor Red
}

Write-Host "`n============================================================" -ForegroundColor Cyan
Write-Host "IMPORT-SCHEDULE" -ForegroundColor Cyan
Write-Host "============================================================`n" -ForegroundColor Cyan

Write-Host "23:30 Uhr - Importiere neue Claude-Sessions`n" -ForegroundColor White
Write-Host "08:00 Uhr - Morning Training (mit neuen Sessions!)" -ForegroundColor Yellow
Write-Host "20:00 Uhr - Evening Training (mit neuen Sessions!)`n" -ForegroundColor Yellow

Write-Host "= Najika lernt aus ALLEN Sessions automatisch!`n" -ForegroundColor Green

Write-Host "============================================================" -ForegroundColor Cyan
Write-Host "SETUP ABGESCHLOSSEN!" -ForegroundColor Green
Write-Host "============================================================`n" -ForegroundColor Cyan
