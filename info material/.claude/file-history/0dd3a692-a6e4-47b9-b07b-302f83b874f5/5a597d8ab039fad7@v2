#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import sys
sys.stdout.reconfigure(encoding='utf-8')

from najika_memory import NajikaMemory

m = NajikaMemory()
p = m.client.get_collection('najika_personalities')
data = p.get()

print("=" * 60)
print("ANALYSE VORHANDENER PERSÖNLICHKEITEN")
print("=" * 60)
print()

# Gruppiere nach Source
sources = {}
for i, doc in enumerate(data['documents']):
    source = data['metadatas'][i].get('source', 'Unknown')
    if source not in sources:
        sources[source] = []
    sources[source].append({
        'doc': doc,
        'meta': data['metadatas'][i]
    })

# Zeige Details
for source, examples in sorted(sources.items()):
    print(f"\n{'='*60}")
    print(f"{source}: {len(examples)} Beispiele")
    print('='*60)

    # Zeige erstes Beispiel komplett
    print("\nERSTES BEISPIEL:")
    print(examples[0]['doc'][:800])
    print("\n...")

    if len(examples) > 1:
        print(f"\nWEITERE {len(examples)-1} Beispiele vorhanden")

print("\n" + "=" * 60)
print("ZUSAMMENFASSUNG")
print("=" * 60)
for source, examples in sorted(sources.items()):
    print(f"{source}: {len(examples)}")
