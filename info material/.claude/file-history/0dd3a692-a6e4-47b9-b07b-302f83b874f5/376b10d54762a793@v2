#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import sys
sys.stdout.reconfigure(encoding='utf-8')

from najika_memory import NajikaMemory

m = NajikaMemory()
p = m.client.get_collection('najika_personalities')
data = p.get()

print(f"Personalities gesamt: {len(data['documents'])}")
print("\nQuellen:")
sources = set([d.get('source', 'Unknown') for d in data['metadatas']])
for source in sorted(sources):
    count = sum(1 for d in data['metadatas'] if d.get('source') == source)
    print(f"  - {source}: {count}")

print("\nBeispiel (erste 500 Zeichen):")
if data['documents']:
    print(data['documents'][0][:500])
