# Training-Times: 00:00, 06:00, 12:00, 18:00
$times = @("00:00", "06:00", "12:00", "18:00")
$names = @("Night", "Morning", "Afternoon", "Evening")

for ($i = 0; $i -lt $times.Length; $i++) {
    $taskName = "NajikaLoRAUltimate_$($names[$i])"
    $time = $times[$i]

    Write-Host "[$($i+1)/4] $taskName ($time)..." -ForegroundColor Green

    $action = New-ScheduledTaskAction -Execute "python" -Argument "C:\NajikaCore\najika_lora_training.py"
    $trigger = New-ScheduledTaskTrigger -Daily -At $time
    Register-ScheduledTask -TaskName $taskName -Action $action -Trigger $trigger -Force | Out-Null

    if ($?) {
        Write-Host "      [OK] Task created" -ForegroundColor Green
    } else {
        Write-Host "      [ERROR] Task creation failed" -ForegroundColor Red
    }
}

