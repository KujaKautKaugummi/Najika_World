#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
🚀 DEPLOY LORA TO OLLAMA 🚀

Merged LoRA-Adapter mit Base-Model und exportiert zu Ollama
"""

import sys
sys.stdout.reconfigure(encoding='utf-8')

import os
import subprocess
from pathlib import Path
from datetime import datetime

# ===== CONFIG =====

LORA_ADAPTER = "C:/NajikaCore/lora_checkpoints/najika_lora_latest"
BASE_MODEL = "unsloth/Meta-Llama-3.1-8B-Instruct"
OUTPUT_DIR = "C:/NajikaCore/merged_models"
GGUF_OUTPUT = "C:/NajikaCore/gguf_models"
OLLAMA_MODEL_NAME = "najika-local"

print("=" * 60)
print("🚀 DEPLOY LORA TO OLLAMA")
print("=" * 60)
print(f"LoRA Adapter: {LORA_ADAPTER}")
print(f"Base Model: {BASE_MODEL}")
print(f"Ollama Model: {OLLAMA_MODEL_NAME}")
print()

# ===== CHECK =====

if not Path(LORA_ADAPTER).exists():
    print("❌ LoRA Adapter nicht gefunden!")
    sys.exit(1)

# ===== IMPORT =====

print("📦 Importiere Libraries...")

try:
    from transformers import AutoModelForCausalLM, AutoTokenizer
    from peft import PeftModel
    import torch
    print("✅ Libraries geladen")
except ImportError as e:
    print(f"❌ Import-Fehler: {e}")
    sys.exit(1)

# ===== STEP 1: MERGE =====

print("\n" + "=" * 60)
print("STEP 1: MERGE LORA + BASE MODEL")
print("=" * 60)

try:
    print("⚙️  Lade Base Model...")
    base_model = AutoModelForCausalLM.from_pretrained(
        BASE_MODEL,
        torch_dtype=torch.float16,
        device_map="auto"
    )

    tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL)

    print("✅ Base Model geladen")

    print("⚙️  Lade LoRA Adapter...")
    model = PeftModel.from_pretrained(base_model, LORA_ADAPTER)

    print("✅ LoRA Adapter geladen")

    print("⚙️  Merge LoRA → Base Model...")
    merged_model = model.merge_and_unload()

    print("✅ Merge abgeschlossen!")

    # Speichere Merged Model
    os.makedirs(OUTPUT_DIR, exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    merged_path = os.path.join(OUTPUT_DIR, f"najika_merged_{timestamp}")

    print(f"💾 Speichere Merged Model: {merged_path}")
    merged_model.save_pretrained(merged_path)
    tokenizer.save_pretrained(merged_path)

    print("✅ Merged Model gespeichert!")

except Exception as e:
    print(f"❌ Merge-Fehler: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)

# ===== STEP 2: GGUF EXPORT =====

print("\n" + "=" * 60)
print("STEP 2: EXPORT TO GGUF (OLLAMA FORMAT)")
print("=" * 60)

os.makedirs(GGUF_OUTPUT, exist_ok=True)
gguf_file = os.path.join(GGUF_OUTPUT, f"najika_{timestamp}.gguf")

print(f"⚙️  Exportiere zu GGUF: {gguf_file}")
print("⚠️  Das kann 5-10 Minuten dauern...")

try:
    # Nutze llama.cpp's convert.py (falls verfügbar)
    # Alternative: Nutze Unsloth's save_pretrained_gguf

    from unsloth import FastLanguageModel

    print("⚙️  Lade Merged Model mit Unsloth...")
    model, tokenizer = FastLanguageModel.from_pretrained(
        model_name=merged_path,
        max_seq_length=2048,
        dtype=None,
        load_in_4bit=False
    )

    print("⚙️  Exportiere zu GGUF (Q4_K_M)...")
    model.save_pretrained_gguf(
        GGUF_OUTPUT,
        tokenizer,
        quantization_method="q4_k_m"
    )

    print("✅ GGUF Export abgeschlossen!")

except Exception as e:
    print(f"⚠️  Unsloth GGUF Export fehlgeschlagen: {e}")
    print("ℹ️  Versuche manuelle Konvertierung...")

    # Fallback: Nutze Huggingface Format und importiere direkt
    print("⚙️  Nutze Merged Model direkt für Ollama...")
    gguf_file = merged_path

# ===== STEP 3: OLLAMA IMPORT =====

print("\n" + "=" * 60)
print("STEP 3: IMPORT TO OLLAMA")
print("=" * 60)

# Erstelle Modelfile
modelfile_content = f"""FROM {gguf_file}

TEMPLATE \"\"\"<|start_header_id|>system<|end_header_id|>

Du bist Najika - eine KI mit 4 Persönlichkeiten (Megumin, Harley, Shiro, Melissa).
Du sprichst Deutsch und bist freundlich, kreativ und hilfsbereit.<|eot_id|><|start_header_id|>user<|end_header_id|>

{{{{ .Prompt }}}}<|eot_id|><|start_header_id|>assistant<|end_header_id|>

\"\"\"

PARAMETER temperature 0.8
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1
PARAMETER num_ctx 4096
"""

modelfile_path = os.path.join(GGUF_OUTPUT, "Modelfile")
with open(modelfile_path, 'w', encoding='utf-8') as f:
    f.write(modelfile_content)

print(f"✅ Modelfile erstellt: {modelfile_path}")

# Importiere zu Ollama
print(f"⚙️  Importiere zu Ollama als '{OLLAMA_MODEL_NAME}'...")

try:
    result = subprocess.run(
        ['ollama', 'create', OLLAMA_MODEL_NAME, '-f', modelfile_path],
        capture_output=True,
        text=True,
        timeout=600
    )

    if result.returncode == 0:
        print("✅ Ollama Import erfolgreich!")
    else:
        print(f"❌ Ollama Import fehlgeschlagen!")
        print(f"STDOUT: {result.stdout}")
        print(f"STDERR: {result.stderr}")
        sys.exit(1)

except Exception as e:
    print(f"❌ Ollama Import-Fehler: {e}")
    sys.exit(1)

# ===== FERTIG =====

print("\n" + "=" * 60)
print("✅ DEPLOYMENT ABGESCHLOSSEN!")
print("=" * 60)
print()
print(f"🎯 Najika Model: {OLLAMA_MODEL_NAME}")
print()
print("Test mit:")
print(f"  ollama run {OLLAMA_MODEL_NAME}")
print()
print("najika_server.py nutzt jetzt automatisch das neue Modell!")
print()
