#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
🚀 EXPORT LORA TO GGUF (MEMORY-EFFICIENT) 🚀

Exportiert LoRA direkt zu GGUF ohne Full-Merge (spart RAM!)
"""

import sys
sys.stdout.reconfigure(encoding='utf-8')

import os
import subprocess
from pathlib import Path
from datetime import datetime

# ===== CONFIG =====

LORA_ADAPTER = "C:/NajikaCore/lora_checkpoints/najika_lora_latest"
BASE_MODEL = "unsloth/Meta-Llama-3.1-8B-Instruct"
GGUF_OUTPUT = "C:/NajikaCore/gguf_models"
OLLAMA_MODEL_NAME = "najika-local"

print("=" * 60)
print("🚀 EXPORT LORA TO GGUF (UNSLOTH)")
print("=" * 60)
print(f"LoRA Adapter: {LORA_ADAPTER}")
print(f"Base Model: {BASE_MODEL}")
print()

# ===== CHECK =====

if not Path(LORA_ADAPTER).exists():
    print("❌ LoRA Adapter nicht gefunden!")
    sys.exit(1)

# ===== IMPORT =====

print("📦 Importiere Unsloth...")

try:
    from unsloth import FastLanguageModel
    print("✅ Unsloth geladen")
except ImportError as e:
    print(f"❌ Import-Fehler: {e}")
    sys.exit(1)

# ===== LOAD MODEL =====

print("\n⚙️  Lade LoRA Model mit Unsloth (4-bit)...")

try:
    model, tokenizer = FastLanguageModel.from_pretrained(
        model_name=LORA_ADAPTER,
        max_seq_length=2048,
        dtype=None,
        load_in_4bit=True  # Memory-efficient!
    )

    print("✅ LoRA Model geladen!")

except Exception as e:
    print(f"❌ Fehler beim Laden: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)

# ===== EXPORT GGUF =====

print("\n" + "=" * 60)
print("EXPORT TO GGUF (Q4_K_M)")
print("=" * 60)

os.makedirs(GGUF_OUTPUT, exist_ok=True)

print("⚙️  Exportiere zu GGUF...")
print("⚠️  Das kann 5-10 Minuten dauern...")

try:
    model.save_pretrained_gguf(
        GGUF_OUTPUT,
        tokenizer,
        quantization_method="q4_k_m"  # 4-bit quantization
    )

    print("✅ GGUF Export abgeschlossen!")

except Exception as e:
    print(f"❌ GGUF Export-Fehler: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)

# ===== FIND GGUF FILE =====

print("\n⚙️  Suche GGUF-File...")

gguf_files = list(Path(GGUF_OUTPUT).glob("*.gguf"))

if not gguf_files:
    print("❌ Keine GGUF-Datei gefunden!")
    sys.exit(1)

gguf_file = str(gguf_files[0])  # Nehme erste GGUF
print(f"✅ GGUF gefunden: {gguf_file}")

# ===== OLLAMA IMPORT =====

print("\n" + "=" * 60)
print("IMPORT TO OLLAMA")
print("=" * 60)

# Erstelle Modelfile
modelfile_content = f"""FROM {gguf_file}

TEMPLATE \"\"\"<|start_header_id|>system<|end_header_id|>

Du bist Najika - eine KI mit 4 Persönlichkeiten (Megumin, Harley, Shiro, Melissa).
Du sprichst Deutsch und bist freundlich, kreativ und hilfsbereit.<|eot_id|><|start_header_id|>user<|end_header_id|>

{{{{ .Prompt }}}}<|eot_id|><|start_header_id|>assistant<|end_header_id|>

\"\"\"

PARAMETER temperature 0.8
PARAMETER top_p 0.9
PARAMETER repeat_penalty 1.1
PARAMETER num_ctx 4096
"""

modelfile_path = os.path.join(GGUF_OUTPUT, "Modelfile")
with open(modelfile_path, 'w', encoding='utf-8') as f:
    f.write(modelfile_content)

print(f"✅ Modelfile erstellt")

# Importiere zu Ollama
print(f"\n⚙️  Importiere zu Ollama als '{OLLAMA_MODEL_NAME}'...")

try:
    result = subprocess.run(
        ['ollama', 'create', OLLAMA_MODEL_NAME, '-f', modelfile_path],
        capture_output=True,
        text=True,
        timeout=600
    )

    if result.returncode == 0:
        print("✅ Ollama Import erfolgreich!")
    else:
        print(f"❌ Ollama Import fehlgeschlagen!")
        print(f"STDOUT: {result.stdout}")
        print(f"STDERR: {result.stderr}")
        sys.exit(1)

except Exception as e:
    print(f"❌ Ollama Import-Fehler: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)

# ===== FERTIG =====

print("\n" + "=" * 60)
print("✅ DEPLOYMENT ABGESCHLOSSEN!")
print("=" * 60)
print()
print(f"🎯 Najika Model: {OLLAMA_MODEL_NAME}")
print()
print("Test mit:")
print(f"  ollama run {OLLAMA_MODEL_NAME}")
print()
print("najika_server.py nutzt jetzt automatisch das neue Modell!")
print()
