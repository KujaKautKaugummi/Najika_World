    "Badezimmer": ["Toilette", "Waschen"],
    "Garten": ["Gießen", "Ernten", "Garten-Spiel"],
    "Musikraum": ["Rhythmus-Spiel"],
    "Medizin": ["Heilen"],
    "Terminal": ["Cloud", "Status", "Besen-Lieferung", "Hacker-Modus", "LoRA Training"],
    "Studieren & Crafting": ["Studieren", "Crafting"],
    "Trainingszimmer": ["Reflex-Spiel", "Trainieren"],
    "Kampfarena": ["Kampf starten"],
    "Schwarze Mühle - Keller": ["Kampf starten", "Erkunden"]
};
const BATTLE_ROOMS = new Set(["Kampfarena", "Schwarze Mühle - Keller"]);

const statusDot = document.querySelector('.status-dot');
const statusText = document.getElementById('statusText');
const providerLabel = document.getElementById('providerLabel');
const cameraButtons = [
    document.getElementById('cam-orbit'),
    document.getElementById('cam-third'),
    document.getElementById('cam-first')
];
const faceBtn = document.getElementById('faceNajikaBtn');
const webcamToggle = document.getElementById('webcamBtn');
const webcamFeed = document.getElementById('webcamFeed');
let webcamActive = false;
let availableRooms = [];

// Terminal-Raum Passwort-Schutz
let terminalUnlocked = false;
const TERMINAL_PASSWORD = '123456';

function setServerStatus(online) {
    if (!statusDot || !statusText) return;
    if (online) {
        statusDot.classList.remove('offline');
        statusText.textContent = 'Online';
    } else {
        statusDot.classList.add('offline');
        statusText.textContent = 'Offline';
    }
}

window.setServerStatus = setServerStatus;

async function api(path, method = 'GET', body) {
    const options = {
        method,
        headers: {'Content-Type': 'application/json'}
    };
    if (body) {
        options.body = JSON.stringify(body);
    }
    try {
        const response = await fetch(path, options);
        if (!response.ok) {
            throw new Error(response.status + ' ' + response.statusText);
        }
        const data = await response.json();
        setServerStatus(true);
        return data;
    } catch (error) {
        setServerStatus(false);
        throw error;
    }
}

async function cloudStatus() {
    return api('/api/cloud/status');
}

async function toggleCloud() {
    try {
        const info = await cloudStatus();
        if (!info.enabled) {
            const pin = prompt('PIN eingeben:');
            if (!pin) return;
            await api('/api/cloud/enable', 'POST', {pin});
        } else {
            await api('/api/cloud/disable', 'POST');
        }
    } catch (error) {
        console.warn('Cloud-Umschaltung fehlgeschlagen.', error);
        notify('Cloud aktuell nicht erreichbar.');
    } finally {
        applyCloudBtn();
    }
}

async function applyCloudBtn() {
    const btn = document.getElementById('cloud');
    if (!btn) return;
    try {
        const info = await cloudStatus();
        btn.style.display = 'inline-block';
        btn.textContent = info.enabled ? 'Cloud deaktivieren' : 'Cloud aktivieren';
        if (providerLabel) {
            providerLabel.textContent = 'Provider: ' + (info.provider || 'lokal');
        }
    } catch (error) {
        btn.style.display = 'none';
        if (providerLabel) {
            providerLabel.textContent = 'Provider: offline';
        }
    }
}

