<!-- FINISHER QTE SYSTEM -->
<script>
// Finisher QTE - Vanilla JS (konvertiert von React)
let finisherQTE = null;

class FinisherQTE {
  constructor() {
    this.active = false;
    this.meter = 0;
    this.duration = 3000;
    this.startTime = 0;
    this.mashCount = 0;
    this.lastMashTime = 0;
    this.mashCooldown = 100;
    this.updateInterval = null;
    this.onCompleteCallback = null;
    this.keyListener = null;
  }

  start(onComplete) {
    this.active = true;
    this.meter = 0;
    this.startTime = Date.now();
    this.mashCount = 0;
    this.lastMashTime = 0;
    this.onCompleteCallback = onComplete;

    console.log('🔥 FINISHER QTE GESTARTET!');

    this.showUI();
    this.updateInterval = setInterval(() => this.update(0.016), 16);

    this.keyListener = (e) => {
      if (e.code === 'Space' && this.active) {
        e.preventDefault();
        this.onMash();
      }
    };
    document.addEventListener('keydown', this.keyListener);

    return { active: true, message: '🔥 FINISH!!! 🔥', instruction: 'SPACE schnell drücken!' };
  }

  onMash() {
    if (!this.active) return { success: false };

    const now = Date.now();
    if (now - this.lastMashTime < this.mashCooldown) return { success: false };

    this.lastMashTime = now;
    this.mashCount++;
    this.meter = Math.min(100, this.meter + 5);

    console.log(`Mash ${this.mashCount}: Meter ${this.meter}%`);
    this.updateUI();

    return { success: true, meter: this.meter, mashCount: this.mashCount };
  }

  update(delta) {
    if (!this.active) return null;

    const now = Date.now();
    const elapsed = now - this.startTime;

    if (elapsed >= this.duration) {
      this.finish();
      return null;
    }

    if (now - this.lastMashTime > 200) {
      this.meter = Math.max(0, this.meter - (delta * 10));
    }

    this.updateUI();
    return { active: true, meter: this.meter, timeLeft: this.duration - elapsed, mashCount: this.mashCount };
  }

  finish() {
    if (!this.active) return null;

    this.active = false;
    if (this.updateInterval) clearInterval(this.updateInterval);
    if (this.keyListener) document.removeEventListener('keydown', this.keyListener);

    const multiplier = 1.0 + (this.meter / 100);
    let rank = 'C';
    if (this.meter >= 90) rank = 'S';
    else if (this.meter >= 70) rank = 'A';
    else if (this.meter >= 50) rank = 'B';

    console.log(`✨ FINISHER! Meter: ${this.meter}%, Multiplier: ${multiplier.toFixed(2)}x, Rank: ${rank}`);

    const messages = {
      'S': '✨ PERFEKT! MAXIMALER SCHADEN! ✨',
      'A': '🔥 EXCELLENT! KRITISCHER TREFFER! 🔥',
      'B': '⚡ GOOD! STARKER ANGRIFF! ⚡',
      'C': '💥 OK! Treffer gelandet! 💥'
    };

    const result = {
      active: false,
      completed: true,
      meter: this.meter,
      multiplier: multiplier,
      mashCount: this.mashCount,
      rank: rank,
      message: messages[rank] || messages['C']
    };

    this.hideUI();
    if (this.onCompleteCallback) this.onCompleteCallback(result);

    return result;
  }

  cancel() {
    if (!this.active) return null;
    this.active = false;
    if (this.updateInterval) clearInterval(this.updateInterval);
    if (this.keyListener) document.removeEventListener('keydown', this.keyListener);
    this.hideUI();
    return { active: false, completed: false, cancelled: true, message: 'Finisher abgebrochen!' };
  }

  isActive() { return this.active; }

  showUI() {
    let overlay = document.getElementById('qteOverlay');
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'qteOverlay';
      overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.8);display:flex;align-items:center;justify-content:center;z-index:10000;animation:qteFlash 0.5s;';
      overlay.innerHTML = `
        <div style="background:linear-gradient(135deg,#1a1a2e,#2d2d44);border:3px solid #ff6b00;border-radius:20px;padding:2rem;text-align:center;box-shadow:0 0 40px rgba(255,107,0,0.6);animation:qteShake 0.3s infinite;">
          <div style="font-size:3rem;font-weight:bold;color:#ff6b00;text-shadow:0 0 20px #ff6b00;margin-bottom:1rem;animation:qtePulse 0.5s infinite;">🔥 FINISH!!! 🔥</div>
          <div style="font-size:1.5rem;color:#fff;margin-bottom:2rem;font-weight:bold;">SPACE SCHNELL DRÜCKEN!</div>
          <div style="position:relative;width:400px;height:50px;background:#1a1a2e;border:2px solid #ff6b00;border-radius:25px;overflow:hidden;margin:0 auto 1rem;">
            <div id="qteMeterBar" style="position:absolute;left:0;top:0;height:100%;width:0%;background:linear-gradient(90deg,#ff6b00,#ff0000);transition:width 0.1s;box-shadow:0 0 20px rgba(255,107,0,0.8);"></div>
            <div id="qteMeterText" style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:bold;color:#fff;text-shadow:2px 2px 4px #000;">0%</div>
          </div>
          <div style="font-size:1.2rem;color:#ccc;"><span id="qteTime">3.0s</span> | <span id="qteMashes">0 Mashes</span></div>
        </div>
      `;
      document.body.appendChild(overlay);

      // CSS Animations
      const style = document.createElement('style');
      style.textContent = `
        @keyframes qteFlash { 0% { background: rgba(255,100,0,0.8); } 100% { background: rgba(0,0,0,0.8); } }
        @keyframes qteShake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
        @keyframes qtePulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
      `;
      document.head.appendChild(style);
    }
    overlay.style.display = 'flex';
    this.updateUI();
  }

  updateUI() {
    const bar = document.getElementById('qteMeterBar');
    const text = document.getElementById('qteMeterText');
    const time = document.getElementById('qteTime');
    const mash = document.getElementById('qteMashes');

    if (bar) bar.style.width = `${this.meter}%`;
    if (text) text.textContent = `${Math.floor(this.meter)}%`;
    if (time && this.active) {
      const left = Math.max(0, this.duration - (Date.now() - this.startTime));
      time.textContent = `${(left / 1000).toFixed(1)}s`;
    }
    if (mash) mash.textContent = `${this.mashCount} Mashes`;
  }

  hideUI() {
    const overlay = document.getElementById('qteOverlay');
    if (overlay) overlay.style.display = 'none';
  }
}

// Globale Instanz
finisherQTE = new FinisherQTE();
</script>

<!-- EVOLUTION SYSTEM -->
<script>
// Evolution System - Simplified Digimon World Style
let evolutionSystem = null;

class EvolutionSystem {
  constructor() {
    this.battleXP = 0;
    this.evolutionStage = 'rookie'; // rookie → champion → ultimate → mega
    this.totalVictories = 0;
  }

  // Berechne Stage basierend auf XP
  calculateStage() {
    if (this.battleXP >= 1000) return 'mega';
    if (this.battleXP >= 500) return 'ultimate';
    if (this.battleXP >= 100) return 'champion';
    return 'rookie';
  }

  // Füge XP hinzu und prüfe Evolution
  addXP(xp) {
    const oldStage = this.evolutionStage;
    this.battleXP += xp;
    this.evolutionStage = this.calculateStage();

    console.log(`+${xp} XP! Total: ${this.battleXP} XP | Stage: ${this.evolutionStage}`);

    // Evolution passiert?
    if (oldStage !== this.evolutionStage) {
      return {
        evolved: true,
        oldStage,
        newStage: this.evolutionStage,
        message: this.getEvolutionMessage(this.evolutionStage),
        battleXP: this.battleXP
      };
    }

    return { evolved: false, battleXP: this.battleXP };
  }

  // Evolution Messages
  getEvolutionMessage(stage) {
    const messages = {
      'champion': '⭐ Kuja! Ich verstehe jetzt besser was du willst!',
      'ultimate': '✨ Wir sind ein Team, Kuja! Ich kann fast alleine kämpfen!',
      'mega': '🌟 PERFEKT! Ich kenne dich jetzt so gut, Kuja!'
    };
    return messages[stage] || '';
  }

  // Hole Stage-Icon
  getStageIcon(stage = null) {
    const icons = {
      'rookie': '🌱',
      'champion': '⭐',
      'ultimate': '✨',
      'mega': '🌟'
    };
    return icons[stage || this.evolutionStage] || '🌱';
  }

  // Hole XP für nächste Evolution
  getXPForNextStage() {
    const thresholds = {
      'rookie': 100,
      'champion': 500,
      'ultimate': 1000,
      'mega': Infinity
    };
    return thresholds[this.evolutionStage];
  }

  // Hole Progress %
  getProgressPercent() {
    const next = this.getXPForNextStage();
    if (next === Infinity) return 100;

    const prev = this.evolutionStage === 'ultimate' ? 500 :
                 this.evolutionStage === 'champion' ? 100 : 0;

    return Math.floor(((this.battleXP - prev) / (next - prev)) * 100);
  }

  // Siege zählen
  addVictory() {
    this.totalVictories++;
  }

  // Hole Status
  getStatus() {
    return {
      stage: this.evolutionStage,
      icon: this.getStageIcon(),
      battleXP: this.battleXP,
      nextStageXP: this.getXPForNextStage(),
      progress: this.getProgressPercent(),
      victories: this.totalVictories
    };
  }
}

// Globale Instanz
evolutionSystem = new EvolutionSystem();

// Zeige Evolution Notification
function showEvolutionNotification(evolutionResult) {
  if (!evolutionResult.evolved) return;

  notify(`🎉 EVOLUTION! ${evolutionResult.oldStage.toUpperCase()} → ${evolutionResult.newStage.toUpperCase()}!`, 'info');
  notify(evolutionResult.message, 'info');

  console.log('✨ EVOLUTION!', evolutionResult);

  // TODO: Visual Evolution Effect (Fullscreen Animation)
}

// ===== LORA TRAINING UI =====
let trainingModal = null;
let trainingInterval = null;

async function openLoRATraining() {
    // Checke Status
    try {
        const status = await api('/api/training/status');

        // Erstelle Modal
        if (trainingModal) trainingModal.remove();

        trainingModal = document.createElement('div');
        trainingModal.style.cssText = `
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9); z-index: 10000; display: flex;
            align-items: center; justify-content: center; font-family: monospace;
        `;

        trainingModal.innerHTML = `
            <div style="background: linear-gradient(135deg, #1a1a2e, #16213e);
                        border: 2px solid #0ff; padding: 30px; border-radius: 10px;
                        max-width: 600px; width: 90%; color: #0ff;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h2 style="margin: 0;">🚀 LoRA TRAINING</h2>
                    <button onclick="closeLoRATraining()" style="background: #f00; color: #fff; border: none; padding: 8px 15px; cursor: pointer; border-radius: 5px;">✕</button>
                </div>

                <div id="trainingContent"></div>
            </div>
        `;

        document.body.appendChild(trainingModal);
        updateTrainingUI(status);

        // Auto-Update alle 3 Sekunden wenn Training aktiv
        if (status.active) {
            trainingInterval = setInterval(async () => {
                const s = await api('/api/training/status');
                updateTrainingUI(s);
                if (!s.active) clearInterval(trainingInterval);
            }, 3000);
        }

    } catch (error) {
        notify('Training System nicht verfügbar', 'error');
    }
}

function updateTrainingUI(status) {
    const content = document.getElementById('trainingContent');
    if (!content) return;

    if (status.active) {
        // Training läuft
        content.innerHTML = `
            <div style="text-align: center;">
                <div style="font-size: 48px; margin: 20px 0;">⚡</div>
                <div style="font-size: 20px; margin-bottom: 20px;">TRAINING AKTIV</div>
                <div style="background: rgba(0,255,255,0.1); padding: 15px; border-radius: 5px; margin: 15px 0;">
                    <div style="margin: 10px 0;">Status: ${status.status}</div>
                    <div style="margin: 10px 0;">Progress: ${status.progress}%</div>
                    <div style="margin: 10px 0;">Gestartet: ${new Date(status.start_time * 1000).toLocaleTimeString()}</div>
                </div>

                <div style="max-height: 200px; overflow-y: auto; background: rgba(0,0,0,0.5); padding: 10px; border-radius: 5px; text-align: left; font-size: 12px;">
                    ${status.logs.map(log => `<div style="margin: 5px 0;">${log}</div>`).join('')}
                </div>
            </div>
        `;
    } else {
        // Training bereit
        content.innerHTML = `
            <div>
                <div style="margin: 20px 0; padding: 15px; background: rgba(0,255,255,0.1); border-radius: 5px;">
                    <div style="margin: 10px 0;">📊 Model: Llama-3.2-3B-Instruct</div>
                    <div style="margin: 10px 0;">💾 VRAM: ~8GB</div>
                    <div style="margin: 10px 0;">⏱️ Dauer: ~30-60min (10 Epochs)</div>
                </div>

                <div style="margin: 20px 0;">
                    <label style="display: block; margin: 10px 0;">
                        Epochs: <input type="number" id="trainingEpochs" value="10" min="1" max="50" style="background: #000; color: #0ff; border: 1px solid #0ff; padding: 5px; width: 80px;">
                    </label>
                    <label style="display: block; margin: 10px 0;">
                        Batch Size: <input type="number" id="trainingBatch" value="2" min="1" max="8" style="background: #000; color: #0ff; border: 1px solid #0ff; padding: 5px; width: 80px;">
                    </label>
                </div>

                <button onclick="startTraining()" style="width: 100%; padding: 15px; font-size: 18px; background: linear-gradient(135deg, #00ff00, #00aa00); color: #000; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">
                    🚀 TRAINING STARTEN
                </button>

                ${status.error ? `<div style="margin-top: 20px; padding: 10px; background: rgba(255,0,0,0.2); border: 1px solid #f00; border-radius: 5px;">❌ ${status.error}</div>` : ''}
            </div>
        `;
    }
}

async function startTraining() {
    const epochs = parseInt(document.getElementById('trainingEpochs').value);
    const batchSize = parseInt(document.getElementById('trainingBatch').value);

    try {
        notify('Training wird gestartet...', 'info');
        await api('/api/training/start', 'POST', { epochs, batch_size: batchSize });

        // Warte kurz und update UI
        setTimeout(async () => {
            const status = await api('/api/training/status');
            updateTrainingUI(status);

            // Starte Auto-Update
            trainingInterval = setInterval(async () => {
                const s = await api('/api/training/status');
                updateTrainingUI(s);
                if (!s.active) {
                    clearInterval(trainingInterval);
                    notify('Training abgeschlossen!', 'success');
                }
            }, 3000);
        }, 1000);

    } catch (error) {
        notify('Training konnte nicht gestartet werden', 'error');
        console.error(error);
    }
}

function closeLoRATraining() {
    if (trainingModal) {
        trainingModal.remove();
        trainingModal = null;
    }
    if (trainingInterval) {
        clearInterval(trainingInterval);
        trainingInterval = null;
    }
}

</script>

