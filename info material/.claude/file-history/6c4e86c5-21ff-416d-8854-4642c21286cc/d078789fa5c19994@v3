async function battleAttack() {
    try {
        // 🔥 FINISHER QTE! (10% Chance)
        let damageMultiplier = 1.0;
        if (Math.random() < 0.1 && finisherQTE && !finisherQTE.isActive()) {
            notify('🔥 FINISHER CHANCE! 🔥', 'info');

            // Starte QTE und warte auf Ergebnis
            await new Promise((resolve) => {
                finisherQTE.start((result) => {
                    if (result.completed) {
                        damageMultiplier = result.multiplier;
                        notify(result.message, 'info');
                        console.log(`Finisher Multiplier: ${damageMultiplier.toFixed(2)}x`);
                    }
                    resolve();
                });
            });
        }

        // API Call mit Multiplier
        const r = await api('/api/battle/action', 'POST', {
            action: 'attack',
            target_index: 0,
            damage_multiplier: damageMultiplier
        });

        if (r.log && Array.isArray(r.log)) {
            // Zeige Battle-Log
            notify(r.log.join(' | '), 'info');
        }
        // Update HUD mit neuen Daten
        if (r.player) {
            updateBattleHUD({
                hp: r.player.hp,
                max_hp: r.player.max_hp,
                wave: r.wave,
                enemies: r.enemies ? r.enemies.length : 0
            });
        }
        // Kampf beendet?
        if (!r.active) {
            document.getElementById('battlePanel').style.display = 'none';
            if (r.result === 'victory') {
                notify(`Sieg! +${r.xp_earned} XP, +${r.gold_earned} Gold!`);

                // Evolution System: Füge XP hinzu
                if (evolutionSystem && r.xp_earned) {
                    const evolutionResult = evolutionSystem.addXP(r.xp_earned);
                    evolutionSystem.addVictory();

                    // Zeige Evolution Notification
                    if (evolutionResult.evolved) {
                        showEvolutionNotification(evolutionResult);
                    }
                }
            } else if (r.result === 'defeat') {
                notify('Kampf verloren!');
            }
        }
    } catch (error) {
        notify('Kampf nicht verfügbar.');
        console.error(error);
    }
}

// ===== VOICE SYSTEM (TTS) =====
let currentAudio = null;

async function playVoice() {
    const voiceBtn = document.getElementById('chatVoice');

    // Hole letzte Najika-Nachricht
    const lastMessage = chatHistory.filter(m => m.role === 'assistant').pop();
    if (!lastMessage) {
        notify('Keine Nachricht zum Abspielen', 'info');
        return;
    }

    voiceBtn.disabled = true;
    voiceBtn.textContent = '⏳';

    try {
        // Generiere Voice
        console.log('[TTS] Requesting voice for:', lastMessage.content.substring(0, 50) + '...');
        notify('Generiere Megumin-Stimme... (kann 5-10s dauern)', 'info');

        const r = await api('/api/tts', 'POST', {
            text: lastMessage.content,
            personality: 'megumin' // TODO: Dynamisch basierend auf Najika-State
        });

        console.log('[TTS] Response:', r);

        if (r.ok && r.audio) {
            // Stop alte Audio falls vorhanden
            if (currentAudio) {
                currentAudio.pause();
                currentAudio = null;
            }

            // Spiele neue Audio
            console.log('[TTS] Playing audio:', r.audio);
            currentAudio = new Audio(r.audio);

            currentAudio.onloadeddata = () => {
                console.log('[TTS] Audio loaded successfully');
                notify('Spiele Megumin-Stimme ab!', 'success');
            };

            currentAudio.play().then(() => {
                console.log('[TTS] Audio playing successfully');
            }).catch(err => {
                console.error('[TTS] Play error:', err);

                // Autoplay blocked - zeige Hinweis
                if (err.name === 'NotAllowedError') {
                    notify('🔊 Klick hier nochmal um Audio abzuspielen!', 'warning');
                    voiceBtn.textContent = '▶️';
                    voiceBtn.disabled = false;

                    // Beim nächsten Click: Play starten
                    const playOnClick = () => {
                        currentAudio.play().then(() => {
                            voiceBtn.textContent = '⏸️';
                            voiceBtn.removeEventListener('click', playOnClick);
                        }).catch(e => {
                            notify('Audio-Wiedergabe fehlgeschlagen: ' + e.message, 'error');
                            voiceBtn.textContent = '🔊';
                            voiceBtn.disabled = false;
                        });
                    };
                    voiceBtn.addEventListener('click', playOnClick, { once: true });
                } else {
                    notify('Audio-Wiedergabe fehlgeschlagen: ' + err.message, 'error');
                    voiceBtn.textContent = '🔊';
                    voiceBtn.disabled = false;
                    currentAudio = null;
                }
            });

            currentAudio.onended = () => {
                console.log('[TTS] Audio ended');
                voiceBtn.textContent = '🔊';
                voiceBtn.disabled = false;
                currentAudio = null;
            };

            currentAudio.onerror = (e) => {
                console.error('[TTS] Audio error:', e);
                notify('Audio konnte nicht abgespielt werden', 'error');
                voiceBtn.textContent = '🔊';
                voiceBtn.disabled = false;
                currentAudio = null;
            };

        } else {
            notify('Voice-System nicht verfügbar', 'error');
            voiceBtn.textContent = '🔊';
            voiceBtn.disabled = false;
        }

    } catch (error) {
        console.error('TTS Error:', error);
        notify('Voice-System Fehler', 'error');
        voiceBtn.textContent = '🔊';
        voiceBtn.disabled = false;
    }
}

