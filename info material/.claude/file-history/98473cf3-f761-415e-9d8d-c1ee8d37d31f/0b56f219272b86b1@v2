# KAYKIT ASSETS KOPIER-SCRIPT
# Kopiert alle benötigten KayKit 3D Assets von Desktop nach NajikaCore

Write-Host "================================================" -ForegroundColor Cyan
Write-Host "  KAYKIT ASSETS KOPIEREN" -ForegroundColor Cyan
Write-Host "================================================" -ForegroundColor Cyan
Write-Host ""

$ErrorActionPreference = "Stop"

# Pfade
$desktopModels = "C:\Users\0KKK0\Desktop\modelle"
$targetBase = "C:\NajikaCore\assets"

Write-Host "[1/4] Erstelle Zielverzeichnisse..." -ForegroundColor Yellow

# Erstelle Verzeichnisse
$kaykit = "$targetBase\kaykit"
$characters = "$kaykit\characters"
New-Item -ItemType Directory -Path $kaykit -Force | Out-Null
New-Item -ItemType Directory -Path $characters -Force | Out-Null

Write-Host "  -> $kaykit" -ForegroundColor Green
Write-Host "  -> $characters" -ForegroundColor Green

# ===== DUNGEON REMASTERED ASSETS =====

Write-Host ""
Write-Host "[2/4] Kopiere Dungeon Assets..." -ForegroundColor Yellow

$dungeonSource = "$desktopModels\KayKit_DungeonRemastered_1.1_FREE\Assets\gltf"

if (-not (Test-Path $dungeonSource)) {
    Write-Host "  FEHLER: Dungeon Source nicht gefunden!" -ForegroundColor Red
    Write-Host "  Erwarteter Pfad: $dungeonSource" -ForegroundColor Yellow
    exit 1
}

# Assets die wir brauchen
$dungeonAssets = @(
    "wall",
    "floor_tile_large",
    "torch",
    "floor_foundation",
    "ceiling",
    "pillar",
    "banner",
    "barrel",
    "crate"
)

$copiedCount = 0

foreach ($asset in $dungeonAssets) {
    $glb = "$dungeonSource\$asset.glb"
    $bin = "$dungeonSource\$asset.bin"

    if (Test-Path $glb) {
        Copy-Item $glb -Destination "$kaykit\$asset.glb" -Force
        Write-Host "  -> $asset.glb" -ForegroundColor Green
        $copiedCount++

        if (Test-Path $bin) {
            Copy-Item $bin -Destination "$kaykit\$asset.bin" -Force
        }
    } else {
        Write-Host "  ! $asset.glb nicht gefunden (optional)" -ForegroundColor DarkYellow
    }
}

Write-Host "  $copiedCount Dungeon Assets kopiert" -ForegroundColor Cyan

# ===== ADVENTURERS CHARACTER =====

Write-Host ""
Write-Host "[3/4] Kopiere Character (Skeleton Mage)..." -ForegroundColor Yellow

$characterSource = "$desktopModels\KayKit_Adventurers_1.0_FREE\Characters\gltf"

if (-not (Test-Path $characterSource)) {
    # Versuche alternatives Verzeichnis
    $characterSource = "$desktopModels\KayKit_Skeletons_1.0_FREE\Characters\gltf"
}

if (Test-Path $characterSource) {
    # Suche nach Skeleton/Mage Models
    $characterFiles = Get-ChildItem -Path $characterSource -Filter "*.glb"

    foreach ($file in $characterFiles) {
        if ($file.Name -match "skeleton|mage" -or $characterFiles.Count -le 3) {
            Copy-Item $file.FullName -Destination "$characters\$($file.Name)" -Force
            Write-Host "  -> $($file.Name)" -ForegroundColor Green

            # Kopiere auch .bin falls vorhanden
            $binFile = $file.FullName -replace "\.glb$", ".bin"
            if (Test-Path $binFile) {
                Copy-Item $binFile -Destination "$characters\$($file.BaseName).bin" -Force
            }
        }
    }
} else {
    Write-Host "  WARNUNG: Character Source nicht gefunden" -ForegroundColor Yellow
    Write-Host "  Erwarteter Pfad: $characterSource" -ForegroundColor DarkYellow
}

