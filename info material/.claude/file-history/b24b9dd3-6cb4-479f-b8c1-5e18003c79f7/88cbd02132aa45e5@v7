            if STATE["total_interactions"] % 5 == 0:  # Alle 5 Interaktionen loggen
                print(f"[BOND] Beziehungsstärke: {bond}/100 ({STATE['total_interactions']} Interaktionen)")

            # Cache-Lookup (NICHT für Private Mode!)
