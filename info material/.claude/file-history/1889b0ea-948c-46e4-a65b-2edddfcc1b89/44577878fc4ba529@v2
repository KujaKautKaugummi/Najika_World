            <button id="faceNajikaBtn" class="cloud-btn">Najika ausrichten</button>
            <button id="webcamBtn" class="cloud-btn">Webcam</button>
            <button id="cloud" class="cloud-btn" style="display:none">Cloud aktivieren</button>
        </div>
    </header>

    <main id="scene">
    </main>

    <div id="hud">
        <div class="hud-panel" id="najikaPanel">
            <h3 style="display: flex; justify-content: space-between; align-items: center; cursor: pointer;" id="najikaHeader">
                <span>Najika Status</span>
                <button id="najikaToggle" style="background: none; border: none; color: #a3b3ff; font-size: 1.2rem; cursor: pointer; padding: 0; margin: 0;">▼</button>
            </h3>
            <div id="najikaContent">
            <div style="font-size: 0.85rem; margin-bottom: 0.75rem;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                    <span>Lvl <strong id="najikaLevel">1</strong></span>
                    <span style="font-size: 0.75rem; color: #a3b3ff;">XP: <span id="najikaXP">0</span>/100</span>
                </div>
                <div style="font-size: 0.75rem; display: flex; justify-content: space-between; opacity: 0.8;">
                    <span>Care: <span id="najikaCM">0</span></span>
