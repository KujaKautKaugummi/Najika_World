            <!-- DISCIPLINE -->
            <div style="margin-top: 0.5rem; font-size: 0.75rem; display: flex; justify-content: space-between;">
                <span>🎓 Discipline:</span>
                <strong><span id="najikaDiscipline">0</span>%</strong>
            </div>
            <!-- PRAISE/SCOLD BUTTONS -->
            <div style="margin-top: 0.75rem; display: flex; gap: 0.5rem;">
                <button id="praiseBtn" style="flex: 1; padding: 0.5rem; font-size: 0.8rem; background: linear-gradient(135deg, #2ecc71, #27ae60);">👍 Loben</button>
                <button id="scoldBtn" style="flex: 1; padding: 0.5rem; font-size: 0.8rem; background: linear-gradient(135deg, #e74c3c, #c0392b);">👎 Tadeln</button>
            </div>
            </div>
        </div>

        <!-- EQUIPMENT PANEL -->
