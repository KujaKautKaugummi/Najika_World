<script>
const ORIGIN = location.origin;
const ROOM_ACTIONS_FALLBACK = {
    "Wohnzimmer": ["Füttern", "Reden"],
    "Schlafzimmer": ["Schlafen", "Lesen"],
    "Küche": ["Kochen"],
    "Badezimmer": ["Toilette", "Waschen"],
    "Garten": ["Gießen", "Ernten", "Garten-Spiel"],
    "Musikraum": ["Rhythmus-Spiel"],
    "Medizin": ["Heilen"],
    "Terminal": ["Cloud", "Status", "Besen-Lieferung"],
    "Studieren & Crafting": ["Studieren", "Crafting"],
    "Trainingszimmer": ["Reflex-Spiel", "Trainieren"],
    "Kampfarena": ["Kampf starten"],
    "Schwarze Mühle - Keller": ["Kampf starten", "Erkunden"]
};
const BATTLE_ROOMS = new Set(["Kampfarena", "Schwarze Mühle - Keller"]);

const statusDot = document.querySelector('.status-dot');
const statusText = document.getElementById('statusText');
const providerLabel = document.getElementById('providerLabel');
const cameraButtons = [
    document.getElementById('cam-orbit'),
    document.getElementById('cam-third'),
    document.getElementById('cam-first')
];
const faceBtn = document.getElementById('faceNajikaBtn');
const webcamToggle = document.getElementById('webcamBtn');
const webcamFeed = document.getElementById('webcamFeed');
let webcamActive = false;
let availableRooms = [];

function setServerStatus(online) {
    if (!statusDot || !statusText) return;
    if (online) {
        statusDot.classList.remove('offline');
        statusText.textContent = 'Online';
    } else {
        statusDot.classList.add('offline');
        statusText.textContent = 'Offline';
    }
}

window.setServerStatus = setServerStatus;

async function api(path, method = 'GET', body) {
    const options = {
        method,
        headers: {'Content-Type': 'application/json'}
    };
    if (body) {
        options.body = JSON.stringify(body);
    }
    try {
        const response = await fetch(path, options);
        if (!response.ok) {
            throw new Error(response.status + ' ' + response.statusText);
        }
        const data = await response.json();
        setServerStatus(true);
        return data;
    } catch (error) {
        setServerStatus(false);
        throw error;
    }
}

async function cloudStatus() {
    return api('/api/cloud/status');
}

async function toggleCloud() {
    try {
        const info = await cloudStatus();
        if (!info.enabled) {
            const pin = prompt('PIN eingeben:');
            if (!pin) return;
            await api('/api/cloud/enable', 'POST', {pin});
        } else {
            await api('/api/cloud/disable', 'POST');
        }
    } catch (error) {
        console.warn('Cloud-Umschaltung fehlgeschlagen.', error);
        alert('Cloud aktuell nicht erreichbar.');
    } finally {
        applyCloudBtn();
    }
}

async function applyCloudBtn() {
    const btn = document.getElementById('cloud');
    if (!btn) return;
    try {
        const info = await cloudStatus();
        btn.style.display = 'inline-block';
        btn.textContent = info.enabled ? 'Cloud deaktivieren' : 'Cloud aktivieren';
        if (providerLabel) {
            providerLabel.textContent = 'Provider: ' + (info.provider || 'lokal');
        }
    } catch (error) {
        btn.style.display = 'none';
        if (providerLabel) {
            providerLabel.textContent = 'Provider: offline';
        }
    }
}

function setCamButtonState(mode) {
    const modeMap = { orbit: 'cam-orbit', third: 'cam-third', first: 'cam-first' };
    cameraButtons.forEach(btn => {
        if (btn && btn.id === modeMap[mode]) {
            btn.classList.add('active');
        } else if (btn) {
            btn.classList.remove('active');
        }
    });
}

function applyCameraMode(mode) {
    setCamButtonState(mode);
    if (window.Scene3D && typeof window.Scene3D.setCameraMode === 'function') {
        window.Scene3D.setCameraMode(mode);
    }
}

if (cameraButtons[0]) cameraButtons[0].addEventListener('click', () => applyCameraMode('orbit'));
if (cameraButtons[1]) cameraButtons[1].addEventListener('click', () => applyCameraMode('third'));
if (cameraButtons[2]) cameraButtons[2].addEventListener('click', () => applyCameraMode('first'));

if (faceBtn) {
    faceBtn.addEventListener('click', () => {
        if (window.Scene3D && typeof window.Scene3D.faceCharacter === 'function') {
            window.Scene3D.faceCharacter();
        }
    });
}

if (webcamToggle) {
    webcamToggle.addEventListener('click', async () => {
        if (!window.Scene3D || typeof window.Scene3D.toggleWebcam !== 'function') {
            alert('Webcam-Steuerung nicht verfügbar.');
            return;
        }
        webcamToggle.disabled = true;
        try {
            const active = await window.Scene3D.toggleWebcam(webcamFeed);
            webcamActive = active;
            if (active) {
                webcamFeed.style.display = 'block';
                webcamToggle.textContent = 'Webcam AUS';
            } else {
                webcamFeed.style.display = 'none';
                webcamFeed.srcObject = null;
                webcamToggle.textContent = 'Webcam';
            }
        } catch (error) {
            console.warn('Webcam konnte nicht gestartet werden.', error);
            alert('Webcam konnte nicht gestartet werden.');
        } finally {
            webcamToggle.disabled = false;
        }
    });
}

async function handleAction(room, action) {
    switch (action) {
        case 'Füttern':
            try {
                const r = await api('/api/najika/feed', 'POST', {});
                alert(r.msg || 'Najika wurde gefüttert!');
                await fetchNajikaStatus();
            } catch (error) {
                alert('Füttern nicht verfügbar.');
            }
            break;
        case 'Reden':
            openChat();
            break;
        case 'Schlafen':
            try {
                const r = await api('/api/najika/sleep', 'POST', {});
                alert(r.msg || 'Najika hat gut geschlafen!');
                await fetchNajikaStatus();
            } catch (error) {
                alert('Schlafen nicht verfügbar.');
            }
            break;
        case 'Lesen':
            alert('Najika liest ein Buch.');
            break;
        case 'Kochen':
            if (window.MiniGames && typeof window.MiniGames.open === 'function') {
                MiniGames.open('cooking');
            } else {
                alert('Najika kocht etwas Leckeres.');
            }
            break;
        case 'Toilette':
