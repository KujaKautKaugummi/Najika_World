async function init() {
    setCamButtonState('orbit');
    const sel = document.getElementById('room');
    try {
        availableRooms = await api('/api/rooms');
    } catch (error) {
        console.warn('Falle auf lokale Räume zurück.', error);
        availableRooms = Object.keys(ROOM_ACTIONS_FALLBACK);
    }
    if (!Array.isArray(availableRooms) || !availableRooms.length) {
        availableRooms = Object.keys(ROOM_ACTIONS_FALLBACK);
    }
    sel.innerHTML = '';
    availableRooms.forEach(r => {
        const o = document.createElement('option');
        o.value = r;
        o.textContent = r;
        sel.appendChild(o);
    });
    sel.onchange = () => applyRoom(sel.value);

    // Load Najika status initial
    await fetchNajikaStatus();

    // Load Equipment stats initial
    await fetchEquipmentStats();

    // Load Chat history initial
    await loadChatHistory();

    // Dungeon Level Selector
    const dungeonLevelSel = document.getElementById('dungeonLevel');
    if (dungeonLevelSel) {
        dungeonLevelSel.onchange = () => {
            const level = parseInt(dungeonLevelSel.value, 10) || 1;
            if (window.DungeonGenerator) {
                DungeonGenerator.setDungeonLevel(level);
                console.log(`🏰 Dungeon Level set to ${level}`);
                // Raum neu laden um neues Dungeon zu generieren
                const current = sel.value;
                if (current === 'Schwarze Mühle – Keller') {
                    applyRoom(current);
                }
            }
        };
    }

    await applyRoom(sel.value || availableRooms[0]);
    await applyCloudBtn();
    document.getElementById('cloud').onclick = toggleCloud;

    const battleBtn = document.getElementById('battleBtn');
    if (battleBtn) {
        battleBtn.onclick = battleAttack;
    }
    document.addEventListener('scene3d:ready', () => {
        const current = sel.value || availableRooms[0];
        if (current && window.Scene3D && typeof window.Scene3D.changeRoom === 'function') {
            window.Scene3D.changeRoom(current);
        }
        if (window.Scene3D && typeof window.Scene3D.getCameraMode === 'function') {
            setCamButtonState(window.Scene3D.getCameraMode());
        }
    });
    console.log('Najika Digivice initialisiert');
}

