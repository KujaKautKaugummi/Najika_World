            </div>
            <!-- NEEDS -->
            <div class="need-bar" title="Hunger">
                <span style="font-size: 0.8rem;">🍖 <span id="najikaHunger">100</span>%</span>
                <div class="hp-bar" style="height: 10px; margin-top: 0.25rem;">
                    <div class="hp-fill" id="hungerFill" style="background: linear-gradient(90deg, #f39c12, #e67e22); width: 100%;"></div>
                </div>
            </div>
            <div class="need-bar" title="Energie">
                <span style="font-size: 0.8rem;">⚡ <span id="najikaEnergy">100</span>%</span>
                <div class="hp-bar" style="height: 10px; margin-top: 0.25rem;">
                    <div class="hp-fill" id="energyFill" style="background: linear-gradient(90deg, #3498db, #2980b9); width: 100%;"></div>
                </div>
            </div>
            <div class="need-bar" title="Hygiene">
                <span style="font-size: 0.8rem;">🚿 <span id="najikaHygiene">100</span>%</span>
                <div class="hp-bar" style="height: 10px; margin-top: 0.25rem;">
                    <div class="hp-fill" id="hygieneFill" style="background: linear-gradient(90deg, #1abc9c, #16a085); width: 100%;"></div>
                </div>
            </div>
            <div class="need-bar" title="Stimmung">
                <span style="font-size: 0.8rem;">😊 <span id="najikaHappiness">100</span>%</span>
                <div class="hp-bar" style="height: 10px; margin-top: 0.25rem;">
                    <div class="hp-fill" id="happinessFill" style="background: linear-gradient(90deg, #e91e63, #c2185b); width: 100%;"></div>
                </div>
            </div>
            <!-- STATS -->
            <div style="margin-top: 0.75rem; font-size: 0.75rem; display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem;">
                <div>💪 <span id="najikaStr">10</span></div>
                <div>🧠 <span id="najikaInt">10</span></div>
                <div>🎯 <span id="najikaDex">10</span></div>
                <div>✨ <span id="najikaCha">10</span></div>
