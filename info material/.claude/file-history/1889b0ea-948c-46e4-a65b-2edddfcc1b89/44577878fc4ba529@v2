<!doctype html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Najika Digivice v2</title>
<link rel="stylesheet" href="/digivice/static/css/chat.css">
<link rel="stylesheet" href="/digivice/static/css/minigames.css">
<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    height: 100%;
    background: #0b0b0f;
    color: #eaeaea;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    overflow: hidden;
}

#app {
    position: fixed;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto auto;
}

header {
    padding: 0.8rem 1rem;
    background: linear-gradient(135deg, #13131a, #1e1e2e);
    border-bottom: 2px solid #667eea;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
}

header h1 {
    font-size: 1.3rem;
    background: linear-gradient(135deg, #667eea, #764ba2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: bold;
}

.status-bar {
    display: flex;
    gap: 1rem;
    margin-left: auto;
    flex-wrap: wrap;
    align-items: center;
}

.status-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    white-space: nowrap;
}

.status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #2ecc71;
    animation: pulse-dot 2s infinite;
}

.status-dot.offline {
    background: #e74c3c;
    animation: none;
}

@keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

#scene {
    position: relative;
    background: #1a1a2e;
    overflow: hidden;
}

#scene canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
}

#hud {
    position: fixed;
    top: 20px;
    left: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 9999 !important;
    max-width: 260px;
    pointer-events: auto !important;
}

.hud-panel {
    background: rgba(10, 10, 18, 0.95);
    padding: 1rem;
    border-radius: 12px;
    border: 2px solid rgba(102, 126, 234, 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), 0 0 20px rgba(102, 126, 234, 0.3);
    pointer-events: auto !important;
}

.hud-panel h3 {
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
    color: #a3b3ff;
}

#cameraPanel button {
    width: 100%;
    margin-top: 0.5rem;
}

.camera-buttons {
    display: flex;
    gap: 0.5rem;
}

.cam-btn {
    flex: 1;
}

.cam-btn.active {
    background: linear-gradient(135deg, #4ecdc4, #45a9f0);
    color: #0b0b0f;
}

#faceNajika {
    background: linear-gradient(135deg, #00c6ff, #0072ff);
}

#webcamToggle {
    background: linear-gradient(135deg, #ffb347, #ff6b6b);
}

#webcamFeed {
    display: none;
    width: 100%;
    margin-top: 0.75rem;
    border-radius: 10px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    background: #000;
}

.hp-bar {
    width: 100%;
    height: 18px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    overflow: hidden;
    margin-top: 0.5rem;
}

.hp-fill {
    height: 100%;
    background: linear-gradient(90deg, #2ecc71, #27ae60);
    transition: width 0.3s ease;
    width: 100%;
}

.hud-stat {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-size: 0.9rem;
}

.room-actions {
    padding: 1rem;
    background: #13131a;
    border-top: 2px solid #667eea;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
    overflow-x: auto;
}

.room-actions label {
    font-weight: bold;
    color: #667eea;
    white-space: nowrap;
}

#room-actions {
    display: flex;
    gap: 0.5rem;
    flex: 1;
    flex-wrap: wrap;
}

.chat-footer {
    padding: 1rem;
    background: #1a1a2e;
    border-top: 2px solid #764ba2;
    display: flex;
    gap: 0.5rem;
    align-items: center;
}

select, button, input {
    padding: 0.6rem 1rem;
    border: 2px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    color: #eaeaea;
    font-size: 0.95rem;
    outline: none;
    transition: all 0.2s;
}

select:hover, input:hover, button:hover {
    border-color: rgba(102, 126, 234, 0.8);
}

button {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    font-weight: bold;
    cursor: pointer;
    border: none;
}

button:active {
    transform: translateY(1px);
}

button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

button.action-btn {
    background: linear-gradient(135deg, #2a2adf, #3a3af5);
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
}

button.battle-btn {
    background: linear-gradient(135deg, #ff6b6b, #ff4757);
    padding: 0.8rem 1.5rem;
    font-size: 1rem;
}

button.cloud-btn {
    background: linear-gradient(135deg, #3498db, #2980b9);
}

input {
    flex: 1;
}

.private-indicator {
    position: fixed;
    top: 20px;
    right: 20px;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, #ff6b6b, #ff4757);
    border-radius: 25px;
    font-weight: bold;
    display: none;
    animation: pulse 2s infinite;
    z-index: 1000;
    box-shadow: 0 5px 30px rgba(255, 75, 87, 0.6);
}

.private-indicator.active {
    display: block;
}

@keyframes pulse {
    0%, 100% {
        transform: scale(1);
        box-shadow: 0 5px 30px rgba(255, 75, 87, 0.6);
    }
    50% {
        transform: scale(1.05);
        box-shadow: 0 5px 40px rgba(255, 75, 87, 0.8);
    }
}

@media (max-width: 900px) {
    #app {
        grid-template-rows: auto 1fr auto auto;
    }
    #hud {
        position: fixed;
        top: 80px;
        left: 10px;
        right: 10px;
        max-width: 100%;
        flex-direction: row;
        gap: 8px;
        z-index: 9999 !important;
        pointer-events: auto;
    }
    .hud-panel {
        flex: 1;
        min-width: 0;
    }
}

@media (max-width: 768px) {
    header {
        flex-direction: column;
        align-items: flex-start;
    }
    .status-bar {
        margin-left: 0;
        width: 100%;
    }
    #scene {
        min-height: 320px;
    }
}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
</head>
<body>

<div class="private-indicator" id="privateIndicator">PRIVATE MODE AKTIV</div>

<div id="app">
    <header>
        <h1>NAJIKA DIGIVICE v2</h1>
        <div class="status-bar">
            <div class="status-item">
                <div class="status-dot"></div>
                <span id="statusText">Online</span>
            </div>
