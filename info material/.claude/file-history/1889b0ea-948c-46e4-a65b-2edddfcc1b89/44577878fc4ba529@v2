// ===== SNAPCHAT-STYLE CHAT =====
let chatHistory = [];

function renderChatMessage(role, content, animate = true) {
    const messagesDiv = document.getElementById('chatMessages');
    const typingDiv = document.getElementById('chatTyping');

    const msgDiv = document.createElement('div');
    msgDiv.className = `chat-message ${role}`;
    if (!animate) msgDiv.style.animation = 'none';

    const avatar = document.createElement('div');
    avatar.className = 'chat-avatar';
    avatar.textContent = role === 'user' ? '👤' : '🌸';

    const bubble = document.createElement('div');
    bubble.className = 'chat-bubble';
    bubble.textContent = content;

    msgDiv.appendChild(avatar);
    msgDiv.appendChild(bubble);

    messagesDiv.insertBefore(msgDiv, typingDiv);
    messagesDiv.scrollTop = messagesDiv.scrollHeight;
}

async function loadChatHistory() {
    try {
        const data = await api('/api/chat/history');
        if (data.history && Array.isArray(data.history)) {
            chatHistory = data.history;
            // Render history ohne Animation
            data.history.forEach(msg => {
                renderChatMessage(msg.role, msg.content, false);
            });
        }
    } catch (error) {
        console.warn('Chat-History konnte nicht geladen werden.', error);
    }
}

async function sendChatMessage() {
    const input = document.getElementById('chatInput');
    const sendBtn = document.getElementById('chatSend');
    const typingDiv = document.getElementById('chatTyping');

    if (!input) return;
    const text = (input.value || '').trim();
    if (!text) return;

    input.value = '';
    sendBtn.disabled = true;

    // User-Message anzeigen
    renderChatMessage('user', text);
    chatHistory.push({role: 'user', content: text});

    // Typing-Indikator
    typingDiv.classList.add('active');

    try {
        const r = await api('/api/chat', 'POST', {message: text});
        typingDiv.classList.remove('active');

        // Najika-Response anzeigen
        const response = r.response || '...';
        renderChatMessage('assistant', response);
        chatHistory.push({role: 'assistant', content: response});

        // Update Najika Status nach Chat
        await fetchNajikaStatus();
    } catch (error) {
        typingDiv.classList.remove('active');
        renderChatMessage('assistant', 'Verbindung fehlgeschlagen...');
    } finally {
        sendBtn.disabled = false;
        input.focus();
    }
}

function openChat() {
    const overlay = document.getElementById('chatOverlay');
    const input = document.getElementById('chatInput');
    overlay.classList.add('active');
    setTimeout(() => input.focus(), 300);
}

function closeChat() {
    const overlay = document.getElementById('chatOverlay');
    overlay.classList.remove('active');
}

// Najika-Panel Toggle
function toggleNajikaPanel() {
    const content = document.getElementById('najikaContent');
    const toggle = document.getElementById('najikaToggle');

    if (content.style.display === 'none') {
        content.style.display = 'block';
        toggle.textContent = '▼';
    } else {
        content.style.display = 'none';
        toggle.textContent = '▶';
    }
}

// Event Listeners für Chat
document.getElementById('chatToggle').addEventListener('click', openChat);
document.getElementById('chatClose').addEventListener('click', closeChat);
document.getElementById('chatSend').addEventListener('click', sendChatMessage);
document.getElementById('chatInput').addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendChatMessage();
});

