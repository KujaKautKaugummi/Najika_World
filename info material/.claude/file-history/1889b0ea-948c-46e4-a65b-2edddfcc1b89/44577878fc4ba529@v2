                await fetchNajikaStatus();
            } catch (error) {
                alert('Waschen nicht verfügbar.');
            }
            break;
        case 'Gießen':
            try {
                await api('/api/minigame/garden', 'POST', {mode: 'water'});
            } catch (error) {
                console.warn('Gießen offline.', error);
            }
            alert('Der Garten ist versorgt.');
            break;
        case 'Ernten':
            alert('Ernte eingesammelt.');
            break;
        case 'Garten-Spiel':
            if (window.MiniGames && typeof window.MiniGames.open === 'function') {
                MiniGames.open('garden');
            } else {
                try {
                    const gg = await api('/api/minigame/garden', 'POST', {});
                    alert('Garten-Spiel Score: ' + (gg?.result?.score ?? 0));
                } catch (error) {
                    alert('Garten-Spiel nicht verfügbar.');
                }
            }
            break;
        case 'Rhythmus-Spiel':
            try {
                const r = await api('/api/najika/train', 'POST', {stat: 'charisma'});
                alert(r.msg || 'Rhythmus-Training abgeschlossen!');
                await fetchNajikaStatus();
            } catch (error) {
                alert('Rhythmus-Spiel nicht verfügbar.');
            }
            break;
        case 'Heilen':
            try {
                const h = await api('/api/heal', 'POST', {});
                alert('Geheilt! HP: ' + h.hp);
                updateBattleHUD({hp: h.hp, max_hp: 100});
            } catch (error) {
                alert('Heilung nicht verfügbar.');
            }
            break;
        case 'Cloud':
            await toggleCloud();
            break;
        case 'Status':
            try {
                const s = await api('/health');
                alert('Status:\n' + JSON.stringify(s, null, 2));
            } catch (error) {
                alert('Status aktuell offline.');
            }
            break;
        case 'Studieren':
            try {
                const r = await api('/api/najika/train', 'POST', {stat: 'intelligence'});
                alert(r.msg || 'Studieren abgeschlossen!');
                await fetchNajikaStatus();
            } catch (error) {
                alert('Studieren nicht verfügbar.');
            }
            break;
        case 'Crafting':
            try {
                const r = await api('/api/najika/train', 'POST', {stat: 'dexterity'});
                alert(r.msg || 'Crafting abgeschlossen!');
                await fetchNajikaStatus();
            } catch (error) {
                alert('Crafting nicht verfügbar.');
            }
            break;
        case 'Reflex-Spiel':
            if (window.MiniGames && typeof window.MiniGames.open === 'function') {
                MiniGames.open('reflex');
            } else {
                try {
                    const rx = await api('/api/minigame/reflex', 'POST', {});
                    alert('Reflex-Spiel Score: ' + (rx?.result?.score ?? 0));
                } catch (error) {
                    alert('Reflex-Spiel nicht verfügbar.');
                }
            }
            break;
        case 'Trainieren':
            try {
                const r = await api('/api/najika/train', 'POST', {stat: 'strength'});
                alert(r.msg || 'Training abgeschlossen!');
                await fetchNajikaStatus();
            } catch (error) {
                alert('Training nicht verfügbar.');
            }
            break;
        case 'Besen-Lieferung':
            if (window.MiniGames && typeof window.MiniGames.open === 'function') {
                MiniGames.open('broom');
            } else {
                alert('Besen-Lieferung startet.');
            }
            break;
        case 'Kampf starten':
            try {
                const kb = await api('/api/battle/start', 'POST', {room});
                if (kb.ok) {
                    document.getElementById('battlePanel').style.display = 'block';
                    updateBattleHUD({hp: 100, max_hp: 100, wave: 1, enemies: 3});
                    alert('Kampf gestartet!');
                }
            } catch (error) {
                alert('Kampf kann nicht gestartet werden.');
            }
            break;
        case 'Erkunden':
            alert('Du erkundest den Keller der Schwarzen Mühle.');
            break;
        default:
            alert('Aktion: ' + action);
    }
}

async function renderActions(room) {
    let resp;
    try {
        resp = await api('/api/room/actions', 'POST', {room});
    } catch (error) {
        console.warn('Nutze Fallback-Aktionen für "' + room + '".', error);
        resp = {
            battle: BATTLE_ROOMS.has(room),
            actions: ROOM_ACTIONS_FALLBACK[room] || []
        };
    }
    const wrap = document.getElementById('room-actions');
    wrap.innerHTML = '';
    const actions = resp && resp.actions ? resp.actions : ROOM_ACTIONS_FALLBACK[room] || [];
    actions.forEach(a => {
        const b = document.createElement('button');
        b.className = 'action-btn';
        b.textContent = a;
        b.onclick = () => handleAction(room, a);
        wrap.appendChild(b);
    });
    const battlePanel = document.getElementById('battlePanel');
    if (battlePanel) {
        if (!resp || !resp.battle) {
            battlePanel.style.display = 'none';
        }
    }
}

async function applyRoom(name) {
    if (!name) return;
    try {
        await renderActions(name);
    } catch (error) {
        console.warn('Aktionen konnten nicht geladen werden.', error);
    }

    // Zeige Dungeon-Level Selector bei Schwarze Mühle
    const dungeonControl = document.getElementById('dungeonLevelControl');
    if (dungeonControl) {
        if (name === 'Schwarze Mühle – Keller') {
            dungeonControl.style.display = 'flex';
        } else {
            dungeonControl.style.display = 'none';
        }
    }

    if (window.Scene3D && typeof window.Scene3D.changeRoom === 'function') {
        window.Scene3D.changeRoom(name);
    }
}

function updateBattleHUD(data) {
    const hpEl = document.getElementById('battleHP');
    const hpMaxEl = document.getElementById('battleMaxHP');
    const waveEl = document.getElementById('battleWave');
    const enemyEl = document.getElementById('battleEnemies');
    const fillEl = document.getElementById('hpFill');
    if (!hpEl || !hpMaxEl || !fillEl) return;
    if (data.hp !== undefined) {
        hpEl.textContent = data.hp;
        hpMaxEl.textContent = data.max_hp || 100;
        const percentage = Math.max(0, Math.min(100, (data.hp / (data.max_hp || 100)) * 100));
        fillEl.style.width = percentage + '%';
        if (percentage > 60) {
            fillEl.style.background = 'linear-gradient(90deg, #2ecc71, #27ae60)';
        } else if (percentage > 30) {
            fillEl.style.background = 'linear-gradient(90deg, #f39c12, #e67e22)';
        } else {
            fillEl.style.background = 'linear-gradient(90deg, #e74c3c, #c0392b)';
        }
    }
    if (waveEl && data.wave !== undefined) {
        waveEl.textContent = data.wave;
    }
    if (enemyEl && data.enemies !== undefined) {
        enemyEl.textContent = data.enemies;
    }
}

function updateNajikaHUD(data) {
    if (!data) return;
    // Level & XP
    const levelEl = document.getElementById('najikaLevel');
    const xpEl = document.getElementById('najikaXP');
    if (levelEl && data.level !== undefined) levelEl.textContent = data.level;
    if (xpEl && data.xp !== undefined) {
        const xpNeeded = data.level * 100;
        xpEl.textContent = data.xp;
        xpEl.parentElement.innerHTML = `XP: <span id="najikaXP">${data.xp}</span>/${xpNeeded}`;
    }
    // Care Mistakes & Fatigue
    const cmEl = document.getElementById('najikaCM');
    const fatigueEl = document.getElementById('najikaFatigue');
    if (cmEl && data.care_mistakes !== undefined) cmEl.textContent = data.care_mistakes;
    if (fatigueEl && data.fatigue !== undefined) fatigueEl.textContent = Math.round(data.fatigue);
    // Needs
    const updateBar = (id, fillId, value) => {
        const el = document.getElementById(id);
        const fill = document.getElementById(fillId);
        if (el) el.textContent = Math.round(value);
        if (fill) fill.style.width = Math.max(0, Math.min(100, value)) + '%';
    };
    if (data.hunger !== undefined) updateBar('najikaHunger', 'hungerFill', data.hunger);
    if (data.energy !== undefined) updateBar('najikaEnergy', 'energyFill', data.energy);
    if (data.hygiene !== undefined) updateBar('najikaHygiene', 'hygieneFill', data.hygiene);
    if (data.happiness !== undefined) updateBar('najikaHappiness', 'happinessFill', data.happiness);
    // Stats
    const strEl = document.getElementById('najikaStr');
    const intEl = document.getElementById('najikaInt');
    const dexEl = document.getElementById('najikaDex');
    const chaEl = document.getElementById('najikaCha');
    if (strEl && data.strength !== undefined) strEl.textContent = data.strength;
    if (intEl && data.intelligence !== undefined) intEl.textContent = data.intelligence;
    if (dexEl && data.dexterity !== undefined) dexEl.textContent = data.dexterity;
    if (chaEl && data.charisma !== undefined) chaEl.textContent = data.charisma;
    // Discipline
    const disciplineEl = document.getElementById('najikaDiscipline');
    if (disciplineEl && data.discipline !== undefined) disciplineEl.textContent = Math.round(data.discipline);
    // Equipment
    if (data.equipment) {
        const weaponEl = document.getElementById('equipWeapon');
        const armorEl = document.getElementById('equipArmor');
        const accessoryEl = document.getElementById('equipAccessory');
        if (weaponEl) weaponEl.textContent = data.equipment.weapon || '-';
        if (armorEl) armorEl.textContent = data.equipment.armor || '-';
        if (accessoryEl) accessoryEl.textContent = data.equipment.accessory || '-';
    }
}

