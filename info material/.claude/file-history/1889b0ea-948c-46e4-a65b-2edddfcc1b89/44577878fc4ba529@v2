    <video id="webcamFeed" autoplay playsinline muted style="display:none; position:fixed; top:20px; right:20px; width:240px; border-radius:10px; border:2px solid rgba(255,255,255,0.2); z-index:9998;"></video>

    <div class="room-actions">
        <label>Aktionen:</label>
        <div id="room-actions"></div>
    </div>

    <div class="chat-footer">
        <button id="chatToggle" class="cloud-btn" style="flex: 1;">💬 Chat mit Najika öffnen</button>
