@echo off
title NAJIKA SERVER RESTART
color 0C
echo.
echo ========================================================
echo   NAJIKA SERVER RESTART
echo ========================================================
echo.

echo [1/3] Stoppe alle Python-Prozesse...
taskkill /F /IM python.exe /T 2>nul
if errorlevel 1 (
    echo [!] Keine Python-Prozesse gefunden
) else (
    echo [OK] Python-Prozesse gestoppt
)

echo.
echo [2/3] Warte 3 Sekunden...
timeout /t 3 /nobreak >nul

cd /d C:\NajikaCore

echo.
echo [3/3] Starte Server mit NEUEN optimierten Parametern...
echo.
echo ========================================================
echo   Server: http://localhost:8000/
echo   Neue Parameter: temp=0.70, repeat_penalty=1.35
echo   Neuer Prompt: Kompakt, anatomisch korrekt
echo ========================================================
echo.

start "NAJIKA" /B python najika_server.py

echo.
echo [OK] Server wurde neu gestartet!
echo      Najika nutzt jetzt die optimierten Parameter
echo.
echo Druecke eine Taste zum Beenden...
pause >nul
