            print(f"  - {topic}")
    else:
        print("  (keine Training-Daten gefunden)")
    print()

    if topics:
        print("Lade Knowledge für Python:")
        print("-" * 60)
        knowledge = loader.load_knowledge(["python"], max_chars=500)
        if knowledge:
            print(knowledge[:500])
        else:
            print("  (keine Python-Daten verfügbar)")
        print()

    print("=" * 60)
    print("Test abgeschlossen!")
