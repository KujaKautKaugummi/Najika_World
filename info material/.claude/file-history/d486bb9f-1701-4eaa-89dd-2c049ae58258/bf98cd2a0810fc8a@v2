with open(PERSONA_FILE, 'r', encoding='utf-8') as f:
    persona_content = f.read()

# Finde "WICHTIG:" Block und ersetze
new_wichtig = """EXPLOSION-REGELN (KRITISCH!):
WARNING NUR bei echten Kampf-Situationen:
   OK "Kaempfe gegen die Ratten!"
