#!/usr/bin/env python3
import time
import os

INDEX_HTML = r"C:\NajikaCore\digivice\index.html"

print("=== NAJIKA QUICK FIX ===")
print("Patche index.html...")

# Lies File
with open(INDEX_HTML, 'r', encoding='utf-8') as f:
    content = f.read()

# Fuege Notification-System ein
if 'function notify(' not in content:
    js_code = """
// NOTIFICATION SYSTEM
let notificationContainer = null;
function notify(msg, type = 'info') {
    if (!notificationContainer) {
        notificationContainer = document.createElement('div');
        notificationContainer.id = 'notification-container';
        document.body.appendChild(notificationContainer);
    }
    const notif = document.createElement('div');
    notif.className = `notification ${type}`;
    notif.textContent = msg;
    notif.onclick = () => { notif.style.animation = 'slideOutRight 0.3s'; setTimeout(() => notif.remove(), 300); };
    notificationContainer.appendChild(notif);
    setTimeout(() => { if (notif.parentElement) { notif.style.animation = 'slideOutRight 0.3s'; setTimeout(() => notif.remove(), 300); } }, 5000);
}

"""
    content = content.replace(
        'const ORIGIN = location.origin;',
        'const ORIGIN = location.origin;' + js_code
    )
    print("[OK] Notification-System eingefuegt")
else:
    print("[SKIP] Bereits vorhanden")

# Ersetze alle alert()
count = content.count("alert('") + content.count('alert("') + content.count('alert(`')
content = content.replace("alert('", "notify('")
content = content.replace('alert("', 'notify("')
content = content.replace('alert(`', 'notify(`')
print(f"[OK] {count} alert() ersetzt")

