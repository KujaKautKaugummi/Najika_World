/* ===== NOTIFICATION SYSTEM CSS ===== */
/* Füge diesen Code nach dem "@keyframes pulse" Block ein (vor @media (max-width: 900px)) */

#notification-container {
    position: fixed;
    top: 80px;
    right: 20px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 350px;
    pointer-events: none;
}

.notification {
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.95), rgba(118, 75, 162, 0.95));
    border-radius: 12px;
    border-left: 4px solid #667eea;
    color: white;
    font-size: 0.95rem;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    animation: slideInRight 0.3s ease-out;
    pointer-events: auto;
    cursor: pointer;
    word-wrap: break-word;
}

.notification.success {
    background: linear-gradient(135deg, rgba(46, 204, 113, 0.95), rgba(39, 174, 96, 0.95));
    border-left-color: #2ecc71;
}

.notification.error {
    background: linear-gradient(135deg, rgba(231, 76, 60, 0.95), rgba(192, 57, 43, 0.95));
    border-left-color: #e74c3c;
}

.notification.warning {
    background: linear-gradient(135deg, rgba(241, 196, 15, 0.95), rgba(243, 156, 18, 0.95));
    border-left-color: #f1c40f;
    color: #2c3e50;
}

@keyframes slideInRight {
    from { transform: translateX(400px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

@keyframes slideOutRight {
    from { transform: translateX(0); opacity: 1; }
    to { transform: translateX(400px); opacity: 0; }
}
