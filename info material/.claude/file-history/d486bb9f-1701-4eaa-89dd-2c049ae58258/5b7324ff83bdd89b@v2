#!/usr/bin/env python3
"""Fix remaining alert() calls"""
import time

HTML = r"C:\NajikaCore\digivice\index.html"

time.sleep(1)

with open(HTML, 'r', encoding='utf-8') as f:
    content = f.read()

# Ersetze alert in praiseNajika
content = content.replace(
    "alert(r.msg || 'Najika freut sich!');",
    "notify(r.msg || 'Najika freut sich!', 'success');"
)

# Ersetze alert in scoldNajika
content = content.replace(
    "alert(r.msg || 'Najika wurde getadelt!');",
    "notify(r.msg || 'Najika wurde getadelt!', 'warning');"
)

with open(HTML, 'w', encoding='utf-8') as f:
    f.write(content)

print("[OK] Remaining alerts fixed!")
print("- praiseNajika: alert -> notify (success)")
print("- scoldNajika: alert -> notify (warning)")
