            'file': main_series_files[0],
            'start': 600,  # ~10 min
            'duration': 14,
            'name': 'main_s1e1_intro',
            'reason': 'First character introduction'
        })

        # Season 1 Episode 5: Iconic moments
        if len(main_series_files) > 4:
