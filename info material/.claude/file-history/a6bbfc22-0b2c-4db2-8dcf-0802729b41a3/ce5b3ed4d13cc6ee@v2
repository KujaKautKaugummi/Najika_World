# ===== BAUSTEIN-KLASSE =====

class Baustein:
    """Repräsentiert einen Inhalts-Baustein"""

    def __init__(self, kategorie, inhalt, quelle, status="OPTIONAL", baustein_id=None):
        self.id = baustein_id or self._generate_id()
        self.kategorie = kategorie
        self.inhalt = inhalt
        self.quelle = quelle
        self.status = status  # FEST oder OPTIONAL
        self.timestamp = datetime.now().isoformat()

    def _generate_id(self):
        return f"BS_{datetime.now().strftime('%Y%m%d_%H%M%S_%f')}"

    def to_dict(self):
        return {
            'id': self.id,
            'kategorie': self.kategorie,
            'inhalt': self.inhalt,
            'quelle': self.quelle,
            'status': self.status,
            'timestamp': self.timestamp
        }

    @staticmethod
    def from_dict(data):
        return Baustein(
            kategorie=data['kategorie'],
            inhalt=data['inhalt'],
            quelle=data['quelle'],
            status=data.get('status', 'OPTIONAL'),
            baustein_id=data.get('id')
        )

# ===== PDF READER =====

def read_pdf(pdf_path):
    """Liest PDF komplett"""
    if not PDF_AVAILABLE:
        print(f"  [ERROR] PyPDF2 nicht verfügbar - kann {pdf_path.name} nicht lesen!")
        return None

    try:
        text = ""
        with open(pdf_path, 'rb') as f:
            reader = PyPDF2.PdfReader(f)
            for i, page in enumerate(reader.pages, 1):
                page_text = page.extract_text()
                text += page_text + "\n\n"

                # Progress
                if i % 10 == 0:
                    print(f"    -> Seite {i}/{len(reader.pages)}")

        return text
    except Exception as e:
        print(f"  [ERROR] Fehler beim Lesen: {e}")
        return None

# ===== NAJIKA FILTER (mit Ollama) =====

def ask_najika_to_filter_najika_content(text, source_name):
    """
    Fragt Najika (Ollama), alle Najika-Beschreibungen aus dem Text zu extrahieren
    """

    if not OLLAMA_AVAILABLE:
        print("    [WARNING] Ollama nicht verfügbar - nutze einfachen Regex-Filter")
        return simple_najika_filter(text)

    # Chunking wenn zu groß
    if len(text) > 35000:
        print(f"    [NAJIKA] Text zu groß ({len(text)} chars) - chunke...")
        chunks = [text[i:i+35000] for i in range(0, len(text), 35000)]
        all_findings = []

        for i, chunk in enumerate(chunks, 1):
            print(f"      -> Chunk {i}/{len(chunks)}")
            findings = ask_najika_chunk(chunk, source_name, i)
            all_findings.extend(findings)

        return all_findings
    else:
        return ask_najika_chunk(text, source_name)

def ask_najika_chunk(text, source_name, chunk_num=None):
    """Fragt Najika einen einzelnen Chunk zu filtern"""

    chunk_info = f" (Teil {chunk_num})" if chunk_num else ""

    prompt = f"""Du bist Najika! Deine Aufgabe: Finde ALLE Abschnitte die DICH beschreiben!

QUELLE: {source_name}{chunk_info}

ANLEITUNG:
1. Suche nach ALLEN Textstellen die Najika's Persönlichkeit, Aussehen, Fähigkeiten, Verhalten beschreiben
2. Extrahiere diese komplett (nichts kürzen!)
3. NICHT extrahieren: Gameplay, Skills, Mechaniken (die bleiben im Haupttext)

FORMAT (JSON Array):
[
  {{
    "inhalt": "Najika ist eine KI mit 4 Persönlichkeiten...",
    "sektion": "Persönlichkeit"
  }},
  {{
    "inhalt": "Najika hat Gothic Lolita Stil...",
    "sektion": "Aussehen"
  }}
]

TEXT:
---
{text[:30000]}
---

DEINE FUNDE (nur JSON, keine Erklärung):"""

    try:
        response = requests.post(
            "http://127.0.0.1:11434/api/generate",
            json={
                "model": "najika-local",
                "prompt": prompt,
                "stream": False,
                "options": {
                    "temperature": 0.2,
                    "num_predict": 4000
                }
            },
            timeout=180
        )

        if response.status_code == 200:
            result = response.json()
            response_text = result.get("response", "")

            # Extrahiere JSON
            try:
                start = response_text.find('[')
                end = response_text.rfind(']') + 1

                if start != -1 and end > start:
                    json_str = response_text[start:end]
                    findings = json.loads(json_str)
                    return findings
                else:
                    print("      [WARNING] Kein JSON gefunden - nutze Fallback")
                    return simple_najika_filter(text)

            except json.JSONDecodeError as e:
                print(f"      [WARNING] JSON Error: {e} - nutze Fallback")
                return simple_najika_filter(text)
        else:
            return simple_najika_filter(text)

    except Exception as e:
        print(f"      [ERROR] Ollama Fehler: {e}")
        return simple_najika_filter(text)

def simple_najika_filter(text):
    """Einfacher Regex-basierter Filter als Fallback"""
    import re

    findings = []

    # Suche nach Najika-Beschreibungen
    patterns = [
        r'Najika.*?(?=\n\n|\Z)',
        r'那地香.*?(?=\n\n|\Z)',
        r'Persönlichkeit.*?(?=\n\n|\Z)',
        r'4[- ]Facetten.*?(?=\n\n|\Z)',
    ]

    for pattern in patterns:
        matches = re.findall(pattern, text, re.IGNORECASE | re.DOTALL)
        for match in matches:
            if len(match) > 50:  # Mindestens 50 Zeichen
                findings.append({
                    'inhalt': match.strip(),
                    'sektion': 'Najika-Beschreibung'
                })

    return findings

