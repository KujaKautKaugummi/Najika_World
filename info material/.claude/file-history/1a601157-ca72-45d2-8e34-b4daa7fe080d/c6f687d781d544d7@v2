#!/usr/bin/env python3
import json

SESSION = 'C:/Users/0KKK0/.claude/projects/C--NajikaCore/1e75a874-27fc-4133-a038-22081b5aae06.jsonl'

with open(SESSION, 'r', encoding='utf-8') as f:
    all_lines = f.readlines()

# Nur USER Nachrichten extrahieren
user_messages = []
for i, line in enumerate(all_lines):
    try:
        entry = json.loads(line)
        if entry.get('type') == 'user':
            content = entry.get('message', {}).get('content', [])
            text_parts = [item.get('text', '') for item in content if isinstance(item, dict) and item.get('type') == 'text']
            if text_parts:
                user_messages.append({
                    'line': i,
                    'time': entry.get('timestamp', '')[:19],
                    'text': ' '.join(text_parts)
                })
    except:
        pass

# Schreibe letzte 25 USER Nachrichten in File
with open('C:/NajikaCore/LAST_25_USER_MESSAGES.txt', 'w', encoding='utf-8') as out:
    out.write('LETZTE 25 USER-NACHRICHTEN\n')
    out.write('='*80 + '\n\n')

    for i, msg in enumerate(user_messages[-25:], 1):
        out.write(f'\n[{i}] {msg["time"]}\n')
        out.write('-'*80 + '\n')
        out.write(msg['text'][:2000])  # Max 2000 chars
        if len(msg['text']) > 2000:
            out.write(f'\n\n... [GEKUERZT - Original war {len(msg["text"])} chars]')
        out.write('\n' + '='*80 + '\n')

print(f'Written to C:/NajikaCore/LAST_25_USER_MESSAGES.txt')
print(f'Total user messages in session: {len(user_messages)}')
print(f'Last 25 messages extracted')
