    <script>
        function switchTab(tabName) {
            // Hide all tab contents
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
            });

            // Remove active from all tabs
            document.querySelectorAll('.tab').forEach(tab => {
                tab.classList.remove('active');
            });

            // Show selected tab content
            document.getElementById(tabName).classList.add('active');

            // Add active to clicked tab
            event.target.classList.add('active');
        }

        function searchContent() {
            const searchTerm = document.getElementById('searchBox').value.toLowerCase();
            const allContent = document.querySelectorAll('.feature-item, .personality-card, .flow-step, .tree-item');

            allContent.forEach(item => {
                const text = item.textContent.toLowerCase();
                if (text.includes(searchTerm)) {
                    item.style.display = '';
                    item.style.background = 'rgba(255, 107, 107, 0.2)';
                } else {
                    item.style.background = '';
                }
            });
        }

        function triggerExplosion() {
            const explosion = document.createElement('div');
            explosion.className = 'explosion-animation';
            explosion.textContent = '💥';
            document.body.appendChild(explosion);

            setTimeout(() => {
                explosion.remove();
            }, 1000);

            // Play sound if available
            // new Audio('explosion.mp3').play();
        }
    </script>
