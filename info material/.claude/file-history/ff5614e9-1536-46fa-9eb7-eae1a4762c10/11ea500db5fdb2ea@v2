<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Najika - Aktueller Stand Komplett</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a0a1f 0%, #2d1b3d 50%, #1a0a1f 100%);
            color: #fff;
            padding: 20px;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            padding: 40px 20px;
            background: rgba(255, 107, 107, 0.1);
            border-radius: 20px;
            margin-bottom: 30px;
            border: 2px solid #FF6B6B;
        }

        h1 {
            font-size: 3em;
            background: linear-gradient(45deg, #FF6B6B, #9B59B6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 10px;
        }

        .tagline {
            font-size: 1.2em;
            color: #FF6B6B;
            font-style: italic;
        }

        .meta {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .meta-card {
            background: rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: 15px;
            border: 1px solid rgba(255, 107, 107, 0.3);
        }

        .meta-card h3 {
            color: #FF6B6B;
            margin-bottom: 10px;
        }

        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .tab {
            background: rgba(255, 255, 255, 0.1);
            padding: 15px 30px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
            border: 2px solid transparent;
        }

        .tab:hover {
            background: rgba(255, 107, 107, 0.2);
            border-color: #FF6B6B;
        }

        .tab.active {
            background: #FF6B6B;
            border-color: #FF6B6B;
        }

        .content {
            background: rgba(255, 255, 255, 0.05);
            padding: 30px;
            border-radius: 20px;
            border: 1px solid rgba(255, 107, 107, 0.3);
            min-height: 400px;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: fadeIn 0.3s;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .personality-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .personality-card {
            background: linear-gradient(135deg, rgba(255, 107, 107, 0.1), rgba(155, 89, 182, 0.1));
            padding: 20px;
            border-radius: 15px;
            border: 2px solid;
            position: relative;
            overflow: hidden;
        }

        .personality-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: var(--accent-color);
        }

        .personality-card.megumin { --accent-color: #FF4444; border-color: #FF4444; }
        .personality-card.harley { --accent-color: #FF1493; border-color: #FF1493; }
        .personality-card.shiro { --accent-color: #4169E1; border-color: #4169E1; }
        .personality-card.melissa { --accent-color: #9B30FF; border-color: #9B30FF; }

        .percentage {
            font-size: 2em;
            font-weight: bold;
            color: var(--accent-color);
        }

        .feature-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .feature-item {
            background: rgba(255, 255, 255, 0.05);
            padding: 15px;
            border-radius: 10px;
            border-left: 4px solid #FF6B6B;
            transition: transform 0.2s;
        }

        .feature-item:hover {
            transform: translateX(10px);
            background: rgba(255, 107, 107, 0.1);
        }

        .status-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: bold;
            margin-right: 5px;
        }

        .status-implemented {
            background: #00C853;
            color: #000;
        }

        .status-critical {
            background: #FF6B6B;
            color: #fff;
        }

        .status-optional {
            background: #FFA726;
            color: #000;
        }

        .system-flow {
            background: rgba(0, 0, 0, 0.3);
            padding: 20px;
            border-radius: 10px;
            font-family: 'Courier New', monospace;
            margin-top: 20px;
        }

        .flow-step {
            padding: 10px;
            margin: 5px 0;
            background: rgba(255, 107, 107, 0.1);
            border-left: 3px solid #FF6B6B;
        }

        .code-block {
            background: #1e1e1e;
            padding: 15px;
            border-radius: 10px;
            overflow-x: auto;
            margin: 10px 0;
        }

        .code-block code {
            color: #9CDCFE;
            font-family: 'Consolas', monospace;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-top: 20px;
        }

        .stat-box {
            background: rgba(255, 107, 107, 0.1);
            padding: 20px;
            border-radius: 10px;
            text-align: center;
            border: 2px solid rgba(255, 107, 107, 0.3);
        }

        .stat-number {
            font-size: 2.5em;
            font-weight: bold;
            color: #FF6B6B;
        }

        .stat-label {
            font-size: 0.9em;
            color: #ccc;
            margin-top: 5px;
        }

        .tree {
            margin-left: 20px;
        }

        .tree-item {
            padding: 8px;
            margin: 5px 0;
            border-left: 2px solid rgba(255, 107, 107, 0.3);
            padding-left: 15px;
        }

        .importance-star {
            color: #FFD700;
            margin-right: 5px;
        }

        .search-box {
            width: 100%;
            padding: 15px;
            border-radius: 10px;
            border: 2px solid #FF6B6B;
            background: rgba(0, 0, 0, 0.3);
            color: #fff;
            font-size: 1em;
            margin-bottom: 20px;
        }

        .search-box:focus {
            outline: none;
            box-shadow: 0 0 20px rgba(255, 107, 107, 0.5);
        }

        .highlight {
            background: rgba(255, 107, 107, 0.3);
            padding: 2px 5px;
            border-radius: 3px;
        }

        footer {
            text-align: center;
            padding: 30px;
            margin-top: 50px;
            color: #888;
        }

        .explosion-btn {
            background: linear-gradient(45deg, #FF6B6B, #9B59B6);
            border: none;
            color: white;
            padding: 15px 30px;
            font-size: 1.2em;
            border-radius: 10px;
            cursor: pointer;
            transition: transform 0.2s;
            font-weight: bold;
        }

        .explosion-btn:hover {
            transform: scale(1.05);
        }

        .explosion-animation {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 5em;
            animation: explode 1s ease-out;
            pointer-events: none;
            z-index: 1000;
        }

        @keyframes explode {
            0% { opacity: 1; transform: translate(-50%, -50%) scale(0); }
            50% { opacity: 1; transform: translate(-50%, -50%) scale(1.5); }
            100% { opacity: 0; transform: translate(-50%, -50%) scale(3); }
        }
    </style>
</head>
