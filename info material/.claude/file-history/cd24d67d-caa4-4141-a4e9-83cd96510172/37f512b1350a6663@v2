@echo off
REM ========================================
REM FFMPEG AUTO-INSTALLER
REM ========================================

echo.
echo ========================================
echo FFMPEG AUTO-INSTALLER
echo ========================================
echo.

cd /d "%~dp0"

REM Pruefe ob winget verfuegbar
winget --version >nul 2>&1
if %errorLevel% equ 0 (
    echo [*] Installiere FFmpeg via winget...
    winget install --id Gyan.FFmpeg -e --silent
    echo.
    echo [OK] FFmpeg installiert!
    echo.
    echo [*] Teste Installation...
    ffmpeg -version
    echo.
    echo ========================================
    echo INSTALLATION KOMPLETT!
    echo ========================================
    pause
    exit /b 0
)

REM Fallback: Chocolatey
choco --version >nul 2>&1
if %errorLevel% equ 0 (
    echo [*] Installiere FFmpeg via Chocolatey...
    choco install ffmpeg -y
    echo.
    echo [OK] FFmpeg installiert!
    echo.
    echo [*] Teste Installation...
    ffmpeg -version
    echo.
    echo ========================================
    echo INSTALLATION KOMPLETT!
    echo ========================================
    pause
    exit /b 0
)

REM Manuelle Installation
echo [!] Kein Package Manager gefunden (winget/choco)
echo.
echo MANUELLE INSTALLATION:
echo.
echo 1. Gehe zu: https://www.gyan.dev/ffmpeg/builds/
echo 2. Download: ffmpeg-release-essentials.zip
echo 3. Entpacke nach C:\ffmpeg
echo 4. Fuehre aus: ADD_FFMPEG_TO_PATH.bat
echo.
echo ODER: Installiere winget (Windows Package Manager)
echo       Dann fuehre dieses Script nochmal aus!
echo.
pause
