#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
NAJIKA 1-MINUTEN TEST-TRAINING
Testet Ollama Training mit echten Daten
"""

import json
import subprocess
import sys
import io
import time
from pathlib import Path
from datetime import datetime

# Fix Windows console encoding
if sys.platform == 'win32':
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='replace')

NAJIKA_DIR = Path('C:/NajikaCore')
TRAINING_DATA_DIR = NAJIKA_DIR / 'training_data'
TEST_DATA_FILE = TRAINING_DATA_DIR / 'test_training_input.txt'
OUTPUT_FILE = NAJIKA_DIR / 'TEST_TRAINING_OUTPUT.json'

def create_test_data():
    """Erstellt Test-Trainingsdaten"""
    print("[*] Erstelle Test-Trainingsdaten...")

    TRAINING_DATA_DIR.mkdir(exist_ok=True)

    test_content = """# NAJIKA TRAINING TEST DATA

Du bist Najika (那地香) = SAKURA (11 Jahre Gothic-Lolita Trans-Mädchen)

## PERSÖNLICHKEIT:
- MEGUMIN 35%: EXPLOSION! Dramatisch! Die Schwarze Windmühle!
- HARLEY QUINN 25%: *kicher* Puddin'! Chaotisch!
- SHIRO 20%: Wahrscheinlichkeit 87.3%... Analytisch!
- MELISSA MASTERS 20%: Du gehörst MIR! Dominant!

## BEISPIEL-DIALOGE:

User: Wie geht's?
Najika: Mir geht's super, Kuja! *hüpft* Bereit für Abenteuer? ✨

User: Was machst du?
Najika: *poliert Stab* Ich bereite mich auf die nächste EXPLOSION vor!

User: Guten Morgen
Najika: *reibt sich die Augen* Morgen, Mr.K! Hast du gut geschlafen? *gähnt*

## WICHTIGE REGELN:
- Kurze Antworten (1-3 Sätze)
- Dramatisch, theatralisch
- KEINE Rollenbrüche
- Du BIST Najika (nicht spielst sie)
"""

    TEST_DATA_FILE.write_text(test_content, encoding='utf-8')
    print(f"[OK] Test-Daten erstellt: {TEST_DATA_FILE}")
    print(f"[OK] Größe: {len(test_content)} Zeichen")
    return test_content

def run_ollama_training(training_data):
    """Führt 1-Minuten Ollama Training durch"""
    print()
    print("=" * 60)
    print("STARTE 1-MINUTEN OLLAMA TRAINING")
    print("=" * 60)
    print()

    # Test 1: Pruefe ob Ollama läuft
    print("[1/4] Prüfe Ollama...")
    try:
        result = subprocess.run(
            ['ollama', 'list'],
            capture_output=True,
            text=True,
            timeout=10
        )
        if result.returncode != 0:
            print("[!] FEHLER: Ollama nicht verfügbar!")
            return False
        print("[OK] Ollama verfügbar")
    except Exception as e:
        print(f"[!] FEHLER: {e}")
        return False

    # Test 2: Pruefe najika-local Model
    print()
    print("[2/4] Prüfe najika-local Model...")
    if 'najika-local' not in result.stdout:
        print("[!] FEHLER: najika-local Model nicht gefunden!")
        return False
    print("[OK] najika-local gefunden")

    # Test 3: Sende Test-Prompt (simuliert Training)
    print()
    print("[3/4] Sende Test-Prompt...")
    print("[INFO] Simuliert Training mit Test-Daten...")

    start_time = time.time()

    test_prompt = f"""Du bist Najika. Lerne aus diesen Trainingsdaten:

{training_data}

AUFGABE: Antworte kurz (1 Satz): Wer bist du?"""

    try:
        result = subprocess.run(
            ['ollama', 'run', 'najika-local', test_prompt],
            capture_output=True,
            text=True,
            timeout=60,
            encoding='utf-8'
        )

        elapsed = time.time() - start_time

        if result.returncode == 0:
            response = result.stdout.strip()
            print(f"[OK] Ollama Response erhalten ({elapsed:.1f}s)")
            print()
            print("=" * 60)
            print("NAJIKA'S ANTWORT:")
            print("=" * 60)
            print(response)
            print("=" * 60)
            print()

            # Speichere Output
            output_data = {
                "timestamp": datetime.now().isoformat(),
                "training_duration_seconds": elapsed,
                "training_data_size": len(training_data),
                "model": "najika-local",
                "prompt": test_prompt,
                "response": response,
                "success": True
            }

            OUTPUT_FILE.write_text(json.dumps(output_data, indent=2, ensure_ascii=False), encoding='utf-8')
            print(f"[OK] Output gespeichert: {OUTPUT_FILE}")

            return True
        else:
            print(f"[!] FEHLER: Ollama returncode {result.returncode}")
            print(f"[!] STDERR: {result.stderr}")
            return False

    except subprocess.TimeoutExpired:
        print("[!] FEHLER: Timeout (60s)")
        return False
    except Exception as e:
        print(f"[!] FEHLER: {e}")
        return False

    # Test 4: Validiere Speicherung
    print()
    print("[4/4] Validiere Speicherung...")
    if OUTPUT_FILE.exists():
        data = json.loads(OUTPUT_FILE.read_text(encoding='utf-8'))
        print(f"[OK] Output-File existiert")
        print(f"[OK] Response-Länge: {len(data['response'])} Zeichen")
        print(f"[OK] Training-Dauer: {data['training_duration_seconds']:.1f}s")
        return True
    else:
        print("[!] FEHLER: Output-File nicht gefunden!")
        return False

def main():
    """Main entry point"""
    print()
    print("=" * 60)
    print("NAJIKA 1-MINUTEN TEST-TRAINING")
    print("=" * 60)
    print()

    # Erstelle Test-Daten
    training_data = create_test_data()

    # Führe Training durch
    success = run_ollama_training(training_data)

    # Zusammenfassung
    print()
    print("=" * 60)
    print("TEST-ZUSAMMENFASSUNG")
    print("=" * 60)
    if success:
        print("[OK] Training erfolgreich!")
        print(f"[OK] Test-Daten: {TEST_DATA_FILE}")
        print(f"[OK] Output: {OUTPUT_FILE}")
        print()
        print("NÄCHSTE SCHRITTE:")
        print("1. Lege deine Videos in: C:/NajikaCore/training_data/input/video/")
        print("2. Führe aus: PROCESS_TRAINING_DATA.bat")
        print("3. Die verarbeiteten Daten werden in output/processed/ gespeichert")
        print("4. Diese kannst du dann für echtes Training nutzen")
    else:
        print("[!] Training fehlgeschlagen!")
        print("[!] Prüfe die Fehler oben")
    print("=" * 60)
    print()

if __name__ == "__main__":
    main()
