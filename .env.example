# Najika World - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database
POSTGRES_DB=najika_world
POSTGRES_USER=najika
POSTGRES_PASSWORD=changeme_secure_password

# Database URL (used by backend)
DATABASE_URL=postgresql://najika:changeme_secure_password@postgres:5432/najika_world

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:changeme_redis_password@redis:6379/0

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=false

# Application
APP_NAME="Najika World"
APP_VERSION=1.0.0

# ============================================================================
# SECURITY
# ============================================================================

# Secret Keys (generate with: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=changeme_generate_secure_secret_key_minimum_32_characters
JWT_SECRET=changeme_generate_secure_jwt_secret_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS (Comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=*

# ============================================================================
# CELERY (Background Tasks)
# ============================================================================

CELERY_BROKER_URL=redis://:changeme_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme_redis_password@redis:6379/1

# ============================================================================
# AI/TRAINING CONFIGURATION
# ============================================================================

# Training Paths
TRAINING_DATA_DIR=/app/data/training
MODEL_OUTPUT_DIR=/app/models

# Whisper AI (Voice Recognition)
WHISPER_MODEL=base  # tiny, base, small, medium, large

# TTS Engine
TTS_ENGINE=piper  # piper, coqui, espeak

# Model Settings
MAX_TRAINING_JOBS=2
TRAINING_TIMEOUT=3600

# ============================================================================
# FILE STORAGE
# ============================================================================

UPLOAD_MAX_SIZE=10485760  # 10MB in bytes
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.mp3,.wav,.json

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@najika.world
SMTP_FROM_NAME=Najika World

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=/app/logs/najika.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ============================================================================
# RATE LIMITING
# ============================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================================================
# WEBSOCKET CONFIGURATION
# ============================================================================

WS_PING_INTERVAL=30
WS_MAX_CONNECTIONS=1000
WS_MESSAGE_MAX_SIZE=65536  # 64KB

# ============================================================================
# MONITORING (Optional)
# ============================================================================

# Sentry (Error Tracking)
SENTRY_ENABLED=false
SENTRY_DSN=

# Prometheus (Metrics)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_REGISTRATION=true
ENABLE_VOICE_CHAT=true
ENABLE_TRAINING=true
ENABLE_ARENA=true
ENABLE_MULTIPLAYER=true

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Only for development
RELOAD=false  # Auto-reload on code changes
PROFILING_ENABLED=false
MOCK_EXTERNAL_SERVICES=false

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# SSL/HTTPS
FORCE_HTTPS=false
SSL_REDIRECT=false

# Session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# Security Headers
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# ============================================================================
# TIMEZONE
# ============================================================================

TZ=UTC
