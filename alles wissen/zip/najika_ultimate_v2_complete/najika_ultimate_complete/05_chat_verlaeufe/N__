            <div style="flex: 1; margin-left: 10px;">
              <div style="color: #e74c3c; font-size: 18px; margin-bottom: 5px;">${this.enemy.name}</div>
              <div style="background: #333; height: 30px; border-radius: 15px; overflow: hidden;">
                <div id="enemy-hp-bar" style="background: #e74c3c; height: 100%; width: 100%; transition: width 0.3s;"></div>
              </div>
              <div id="enemy-hp-text" style="color: white; margin-top: 5px;">HP: ${this.enemyHP}/${this.enemy.maxHP}</div>
