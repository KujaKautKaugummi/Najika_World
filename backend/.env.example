# ============================================================================
# NAJIKA BACKEND - ENVIRONMENT VARIABLES
# Copy this file to .env and update the values
# ============================================================================

# ============================================================================
# SECURITY
# ============================================================================

# Secret key for JWT tokens (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440  # 24 hours

# ============================================================================
# DATABASE
# ============================================================================

# SQLite (Development)
DATABASE_URL=sqlite:///./najika.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://username:password@localhost:5432/najika

# ============================================================================
# SERVER
# ============================================================================

HOST=0.0.0.0
PORT=8000
DEBUG=True
RELOAD=True

# API Settings
API_PREFIX=/api
RATE_LIMIT_PER_MINUTE=60

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Allowed origins (use * for development, specify domains in production)
CORS_ORIGINS=*
# Production example:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================================================
# TRAINING
# ============================================================================

# Training data directory
TRAINING_DATA_DIR=./training_data

# Model output directory
MODEL_OUTPUT_DIR=./models

# ChromaDB path
CHROMA_DB_PATH=./chroma_db

# ============================================================================
# VOICE & AUDIO
# ============================================================================

# Whisper AI model size (tiny, base, small, medium, large)
WHISPER_MODEL=base

# TTS Engine (edge or coqui)
TTS_ENGINE=edge

# Voice data directory
VOICE_DATA_DIR=./voice_data

# ============================================================================
# GAME SETTINGS
# ============================================================================

# Save files directory
SAVE_DIR=./saves

# Maximum save slots per user
MAX_SAVE_SLOTS=10

# ============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ============================================================================

# Redis (for caching and task queue)
# REDIS_URL=redis://localhost:6379/0

# Celery (for background tasks)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Sentry (for error tracking in production)
# SENTRY_DSN=https://your-sentry-dsn

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Update SECRET_KEY with a strong random key:
#    openssl rand -hex 32
#
# 3. For production:
#    - Set DEBUG=False
#    - Use PostgreSQL instead of SQLite
#    - Set specific CORS_ORIGINS
#    - Use strong SECRET_KEY
#
# ============================================================================
