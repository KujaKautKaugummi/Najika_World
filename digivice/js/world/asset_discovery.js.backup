// 🔍 ASSET DISCOVERY - Findet automatisch alle verfügbaren 3D-Assets
// Scannt die Asset-Ordner und erstellt ein Asset-Verzeichnis

export class AssetDiscovery {
  constructor(basePath = '/static/assets') {
    this.basePath = basePath;
    this.discovered = {
      kaykit: {},
      jellysquish: {},
      quaternius: {},
      total: 0
    };
  }

  /**
   * Auto-Discovery: Scanne alle Asset-Ordner
   */
  async discover() {
    console.log('🔍 Starting asset discovery...');

    // Bekannte Asset-Pakete und deren Strukturen
    const packages = [
      // KayKit Pakete
      { name: 'nature', path: 'kaykit/nature', pattern: '*.gltf' },
      { name: 'dungeon', path: 'kaykit/dungeon', pattern: '*.gltf' },
      { name: 'medieval', path: 'kaykit/medieval', pattern: '*.gltf' },
      { name: 'furniture', path: 'kaykit/furniture', pattern: '*.gltf' },
      { name: 'halloween', path: 'KayKit_HalloweenBits_1.0_FREE/Assets/gltf', pattern: '*.gltf' },
      { name: 'forest', path: 'KayKit_Forest_Nature_Pack_1.0_FREE/Assets/gltf', pattern: '*.gltf' },

      // JellySquish Oasis
      { name: 'oasis', path: 'jellysquish/oasis', pattern: '*.glb' },

      // Quaternius (falls vorhanden)
      { name: 'quaternius_nature', path: 'quaternius/nature', pattern: '*.glb' }
    ];

    for (const pkg of packages) {
      await this.scanPackage(pkg);
    }

    console.log(`✅ Discovery complete: ${this.discovered.total} assets found`);
    return this.discovered;
  }

  /**
   * Scanne ein Asset-Paket
   */
  async scanPackage(pkg) {
    const fullPath = `${this.basePath}/${pkg.path}`;

    try {
      // Versuche INDEX-Datei zu laden (falls existiert)
      const indexPath = `${fullPath}/index.json`;
      const response = await fetch(indexPath);

      if (response.ok) {
        const index = await response.json();
        this.discovered[pkg.name] = index;
        this.discovered.total += Object.keys(index).length;
        console.log(`✅ ${pkg.name}: ${Object.keys(index).length} assets (from index)`);
        return;
      }
    } catch (e) {
      // Index existiert nicht, nutze Standard-Muster
    }

    // Fallback: Nutze vordefinierte Asset-Listen
    const assetList = this.getKnownAssets(pkg.name, fullPath);
    if (assetList.length > 0) {
      this.discovered[pkg.name] = assetList;
      this.discovered.total += assetList.length;
      console.log(`✅ ${pkg.name}: ${assetList.length} assets (predefined)`);
    }
  }

  /**
   * Bekannte Assets für jedes Paket
   * (basierend auf asset_mapping_v2_REAL.json)
   */
  getKnownAssets(packageName, basePath) {
    const knownAssets = {
      // JellySquish Oasis Pack (25 Assets)
      oasis: [
        'palm_l.glb', 'palm_m.glb', 'palm_s.glb',
        'cactus_large.glb', 'cactus_small.glb',
        'rocks_1.glb', 'rocks_2.glb', 'rocks_3.glb',
        'grass_1.glb', 'grass_2.glb', 'grass_3.glb',
        'blue_grass_large.glb', 'blue_grass_small.glb',
        'house_large.glb', 'house_small.glb',
        'basket_large.glb', 'basket_small.glb',
        'pot_l.glb', 'pot_s.glb',
        'chest.glb', 'ladder.glb',
        'platform_l.glb', 'platform_m.glb', 'platform_s.glb'
      ],

      // KayKit Nature (Trees, Bushes, Rocks - Wildcards)
      nature: [
        'tree_*.gltf', 'bush_*.gltf', 'rock_*.gltf',
        'mushroom_*.gltf', 'flower_*.gltf', 'grass_*.gltf',
        'fern_*.gltf', 'campfire_*.gltf'
      ],

      // KayKit Dungeon (200+ Assets - Wildcards)
      dungeon: [
        'wall_*.gltf', 'floor_*.gltf', 'pillar_*.gltf',
        'stairs_*.gltf', 'door_*.gltf', 'crystal_*.gltf',
        'chest_*.gltf', 'torch_*.gltf', 'barrel_*.gltf',
        'crate_*.gltf', 'trap_*.gltf', 'banner_*.gltf',
        'rock_*.gltf', 'stalagmite_*.gltf'
      ],

      // KayKit Medieval (Buildings, Props)
      medieval: [
        'house_*.gltf', 'tower_*.gltf', 'wall_*.gltf',
        'door_*.gltf', 'window_*.gltf', 'roof_*.gltf',
        'market_*.gltf', 'fence_*.gltf'
      ],

      // KayKit Furniture
      furniture: [
        'bed_*.gltf', 'chair_*.gltf', 'table_*.gltf',
        'shelf_*.gltf', 'chest_*.gltf', 'barrel_*.gltf'
      ],

      // KayKit Halloween (Swamp Assets)
      halloween: [
        'tree_dead_*.gltf', 'pumpkin_*.gltf', 'grave_*.gltf',
        'coffin_*.gltf', 'fence_*.gltf', 'lantern_*.gltf'
      ],

      // KayKit Forest
      forest: [
        'tree_*.gltf', 'rock_*.gltf', 'bush_*.gltf',
        'grass_*.gltf', 'flower_*.gltf'
      ]
    };

    const assets = knownAssets[packageName] || [];
    return assets.map(asset => `${basePath}/${asset}`);
  }

  /**
   * Finde Assets für ein Biome
   */
  getAssetsForBiome(biome) {
    const biomeMapping = {
      desert: ['oasis'],
      forest: ['nature', 'forest'],
      caves: ['dungeon'],
      coast: ['oasis', 'nature'],
      highland: ['nature'],
      swamp: ['halloween', 'nature'],
      ice: ['nature'],
      volcano: ['nature', 'dungeon'],
      mountain: ['nature', 'medieval']
    };

    const packages = biomeMapping[biome] || [];
    const assets = [];

    for (const pkg of packages) {
      if (this.discovered[pkg]) {
        assets.push(...this.discovered[pkg]);
      }
    }

    return assets;
  }

  /**
   * Erweitere Asset-Pfad mit Wildcards
   * tree_*.gltf → [tree_1.gltf, tree_2.gltf, ...]
   */
  expandWildcard(pattern, availableFiles) {
    if (!pattern.includes('*')) return [pattern];

    const regex = new RegExp(
      '^' + pattern.replace(/\*/g, '.*') + '$'
    );

    return availableFiles.filter(file => regex.test(file));
  }

  /**
   * Lade Asset-Mapping JSON (Fallback)
   */
  async loadAssetMapping(mappingPath = '/data/asset_mapping_v2_REAL.json') {
    try {
      const response = await fetch(mappingPath);
      const mapping = await response.json();

      console.log('✅ Asset mapping loaded from JSON');

      // Merge mit discovered assets
      this.discovered = {
        ...this.discovered,
        mapping: mapping
      };

      return mapping;
    } catch (error) {
      console.warn('⚠️ Could not load asset mapping JSON:', error);
      return null;
    }
  }

  /**
   * Prüfe ob Asset existiert
   */
  async assetExists(assetPath) {
    try {
      const response = await fetch(assetPath, { method: 'HEAD' });
      return response.ok;
    } catch (e) {
      return false;
    }
  }

  /**
   * Statistiken ausgeben
   */
  getStats() {
    return {
      total: this.discovered.total,
      packages: Object.keys(this.discovered).filter(k => k !== 'total' && k !== 'mapping').length,
      kaykit: Object.keys(this.discovered).filter(k => k.includes('nature') || k.includes('dungeon')).length,
      discovered: this.discovered
    };
  }

  /**
   * Debug: Zeige alle gefundenen Assets
   */
  logDiscovered() {
    console.log('📦 Discovered Assets:');
    console.log(`   Total: ${this.discovered.total}`);

    for (const [pkg, assets] of Object.entries(this.discovered)) {
      if (pkg === 'total' || pkg === 'mapping') continue;
      if (Array.isArray(assets)) {
        console.log(`   ${pkg}: ${assets.length} assets`);
      }
    }
  }
}

export default AssetDiscovery;
