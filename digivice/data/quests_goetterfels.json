  "quests": [
    {
      "id": "die_botschaft_der_goetter",
      "name": "Die Botschaft der Götter",
      "type": "main_quest",
      "difficulty": "medium",
      "level_required": 15,
      "giver": "goetterbote_hermes",
      "description": "Hermes hat eine Botschaft von den Göttern für dich",
      "objectives": [
        {"type": "dialogue", "target": "goetterbote_hermes"},
        {"type": "visit_all_regions", "description": "Besuche alle 9 Regionen"},
        {"type": "return", "target": "goetterbote_hermes"}
      ],
      "najika_reactions": {
        "initial": {"personality": "megumin", "text": "Eine Botschaft von den GÖTTERN! Das ist wichtig!"},
        "completion": {"personality": "melissa", "text": "Die Götter haben einen Plan... Und wir sind Teil davon."}
      },
      "rewards": {"exp": 5000, "items": ["goettlicher_segen"], "title": "Götterbote"}
    },
    {
      "id": "die_zerbrochene_zeit",
      "name": "Die zerbrochene Zeit",
      "type": "legendary_quest",
      "difficulty": "legendary",
      "level_required": 25,
      "giver": "zeitwaechterin_chrona",
      "description": "Die Zeit selbst ist zerbrochen. Repariere sie bevor die Realität zusammenbricht.",
      "objectives": [
        {"type": "collect", "item": "zeitfragmente", "amount": 9, "description": "Ein Fragment aus jeder Region"},
        {"type": "boss_battle", "target": "zeit_paradox_boss"},
        {"type": "repair_time"}
      ],
      "choices": [{
        "trigger": "Zeit repariert",
        "question": "Du kannst die Zeit ändern. Was tust du?",
        "options": [
          {
            "id": "restore_normal",
            "text": "Stelle die normale Zeitlinie wieder her",
            "outcome": {"success": true, "consequence": "Alles wird normal", "rewards": {"exp": 50000, "items": ["zeit_sense"]}}
          },
          {
            "id": "change_past",
            "text": "Ändere die Vergangenheit",
            "outcome": {"warning": "GEFÄHRLICH", "consequence": "Neue Zeitlinie beginnt", "rewards": {"alternate_timeline": true}, "najika_aftermath": {"personality": "shiro", "text": "WARNUNG: Paradox-Risiko: 89%."}}
          },
          {
            "id": "destroy_time",
            "text": "Zerstöre die Zeit komplett (Chaos-Option)",
            "outcome": {"consequence": "REALITÄT KOLLABIERT", "game_over": "Bad Ending", "najika_aftermath": {"personality": "melissa", "text": "Was... hast du getan?"}}
          }
        ]
      }],
      "najika_reactions": {
        "initial": {"personality": "shiro", "text": "Zeit-Anomalie detektiert. Kritisch. Universum in Gefahr."},
        "final_choice": {"personality": "melissa", "text": "Mit der Zeit zu spielen... Das kann nur im Chaos enden."}
      },
      "rewards": {"exp": 50000}
    },
    {
      "id": "die_letzte_prophezeiung",
      "name": "Die letzte Prophezeiung",
      "type": "story_quest",
      "difficulty": "hard",
      "level_required": 20,
      "giver": "seher_orakel",
      "description": "Das Orakel hat eine finale Prophezeiung: Eine große Dunkelheit kommt.",
      "objectives": [
        {"type": "decipher", "description": "Entschlüssle die kryptische Prophezeiung"},
        {"type": "investigate", "description": "Finde die Wahrheit in allen 9 Regionen"},
        {"type": "prepare", "description": "Bereite dich auf die Dunkelheit vor"}
      ],
      "najika_reactions": {
        "initial": {"personality": "melissa", "text": "Prophezeiungen... Sie kommen immer wahr. Immer."}
      },
      "rewards": {"exp": 10000, "items": ["prophezeiung_buch"], "unlocks": "final_story_arc"}
    },
    {
      "id": "das_erwachen_der_goettin",
      "name": "Das Erwachen der Göttin",
      "type": "legendary_quest",
      "difficulty": "legendary",
      "level_required": 30,
      "giver": "goettin_statue",
      "description": "Die Urgöttin erwacht aus ihrem jahrtausendelangen Schlaf. Die Welt wird sich verändern.",
      "objectives": [
        {"type": "collect", "item": "goettliche_essenz", "amount": 9, "description": "Eine Essenz aus jeder Region"},
        {"type": "ritual", "description": "Führe das Erweckungs-Ritual durch"},
        {"type": "choice_event", "description": "Entscheide das Schicksal der Welt"}
      ],
      "choices": [{
        "trigger": "Göttin erwacht",
        "question": "Die Göttin bietet dir eine Wahl: Werde ein Gott oder bleibe sterblich.",
        "options": [
          {
            "id": "become_god",
            "text": "Werde ein Gott",
            "outcome": {
              "transformation": "deity",
              "rewards": {"godhood": true, "immortality": true, "divine_powers": true},
              "consequence": "Du verlässt die sterbliche Welt",
              "ending": "God Ending"
            },
            "najika_aftermath": {
              "personality": "melissa",
              "text": "Du verlässt uns... für die Ewigkeit. Leb wohl, alter Freund."
            }
          },
          {
            "id": "stay_mortal",
            "text": "Bleibe sterblich",
            "outcome": {
              "consequence": "Du bleibst bei deinen Freunden",
              "rewards": {"exp": 100000, "items": ["goettin_segen"], "title": "Der Weise"},
              "ending": "True Ending"
            },
            "najika_aftermath": {
              "personality": "harley",
              "text": "You stayed! *umarmt* I knew you wouldn't leave us!"
            }
          },
          {
            "id": "refuse_both",
            "text": "Lehne beide Optionen ab und schmiedeeigenes Schicksal",
            "requires": "fate_breaker_ability",
            "outcome": {
              "consequence": "Du erschaffst deine eigene Realität",
              "rewards": {"unique_power": "reality_weaver", "items": ["eigene_welt_kristall"]},
              "ending": "Freedom Ending"
            },
            "najika_aftermath": {
              "personality": "megumin",
              "text": "DU HAST DEN GÖTTERN WIDERSPROCHEN! DAS IST... EPISCH!"
            }
          }
        ]
      }],
      "najika_reactions": {
        "initial": {"personality": "melissa", "text": "Eine Göttin... Die Urgöttin selbst. Die Schöpferin dieser Welt."},
        "awakening": {"personality": "megumin", "text": "SIE ERWACHT! Die GÖTTIN SELBST!"},
        "final_choice": {"personality": "all", "text": "Kuja... Was auch immer du wählst... Wir respektieren es."}
      },
      "rewards": {"exp": 100000},
      "unlocks": "game_ending"
    },
