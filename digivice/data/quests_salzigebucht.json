    {
      "id": "das_geister_schiff",
      "name": "Das Geisterschiff",
      "type": "main_quest",
      "difficulty": "hard",
      "level_required": 12,
      "giver": "leuchtturmwaerterin_luna",
      "description": "Luna hat ein Geisterschiff am Horizont gesehen. Es verschwindet bei Tageslicht.",
      "objectives": [
        {"type": "investigate", "target": "geister_schiff", "time": "night_only"},
        {"type": "board_ship"},
        {"type": "find_truth"}
      ],
      "najika_reactions": {
        "initial": {"personality": "harley", "text": "GHOST SHIP?! That's SO COOL! Let's hunt some ghosts!"},
        "boarding": {"personality": "melissa", "text": "Geister... Erinnerungen, die sich weigern zu sterben."}
      },
      "choices": [
        {
          "question": "Das Schiff ist voller Geister toter Seeleute. Sie greifen nicht an, sondern bitten um Hilfe. Was tust du?",
          "options": [
            {
              "id": "help_ghosts",
              "text": "Hilf den Geistern, Frieden zu finden",
              "najika_reaction": {"personality": "melissa", "text": "Sie verdienen Ruhe. Lass uns ihnen helfen."},
              "outcome": {
                "success": true,
                "consequence": "Du findest heraus, dass sie von einem Fluch gefangen sind. Du brichst den Fluch.",
                "rewards": {"gold": 800, "items": ["geister_kompass", "kapitaens_logbuch"], "title": "Geisterbefreier"},
                "reputation": 50
              }
            },
            {
              "id": "loot_ship",
              "text": "Plündere das Schiff und ignoriere die Geister",
              "najika_reaction": {"personality": "harley", "text": "That's... kinda mean. But treasure IS treasure..."},
              "outcome": {
                "success": false,
                "consequence": "Die Geister werden wütend! Du musst fliehen!",
                "rewards": {"gold": 300},
                "reputation": -30,
                "debuff": {"geister_fluch": {"duration": 86400}}
              }
            },
            {
              "id": "exorcism",
              "text": "Vertreibe die Geister mit Magie",
              "requires": "holy_magic",
              "najika_reaction": {"personality": "megumin", "text": "EXPLOSION für Geister? ...Nein? Okay, dann halt Licht-Magie."},
              "outcome": {
                "success": true,
                "consequence": "Die Geister werden befreit. Das Schiff löst sich auf.",
                "rewards": {"exp": 2000, "items": ["heiliges_amulett"]},
                "reputation": 40
              }
            }
          ]
        }
      ],
      "rewards": {"exp": 1500}
    },
