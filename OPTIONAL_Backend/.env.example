# ============================================================================
# OPTIONAL Backend - Environment Variables Example
# ============================================================================
#
# USAGE:
#   1. Kopiere diese Datei nach .env
#   2. Passe die Werte an
#   3. .env wird von python-dotenv geladen
#
# WICHTIG: .env NICHT in Git committen! (steht in .gitignore)
#
# ============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=change_this_to_a_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (wenn SQLite/PostgreSQL genutzt wird)
DATABASE_URL=sqlite:///./najika.db
# DATABASE_URL=postgresql://user:password@localhost/najika_db

# CORS Origins (komma-separiert)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Whisper AI
WHISPER_MODEL=base  # tiny, base, small, medium, large
WHISPER_DEVICE=cpu  # cpu oder cuda

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Redis (optional, für Sessions/Caching)
# REDIS_URL=redis://localhost:6379/0

# Email (optional, für Passwort-Reset etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
