+UNajikaHttpClient::UNajikaHttpClient()
+{
+	BaseURL = TEXT("http://127.0.0.1:8000");
+}
+
+void UNajikaHttpClient::Initialize(const FString& InBaseURL)
+{
+	BaseURL = InBaseURL;
+	UE_LOG(LogTemp, Log, TEXT("[NajikaHttpClient] Initialized with BaseURL: %s"), *BaseURL);
+}
